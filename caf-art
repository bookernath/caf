def q256(r, g, b):
    def c(v):
        return 0 if v < 48 else 1 if v < 114 else (v - 35) // 40
    return 16 + 36 * c(r) + 6 * c(g) + c(b)


def fg(col):
    r, g, b = col
    return f"\x1b[38;2;{r};{g};{b}m" if TRUECOLOR else f"\x1b[38;5;{q256(r, g, b)}m"


def bg(col):
    r, g, b = col
    return f"\x1b[48;2;{r};{g};{b}m" if TRUECOLOR else f"\x1b[48;5;{q256(r, g, b)}m"


def shade(col, k):
    return (min(255, max(0, int(col[0] * k))),
            min(255, max(0, int(col[1] * k))),
            min(255, max(0, int(col[2] * k))))


def mix(a, b, t):
    return (int(a[0] + (b[0] - a[0]) * t),
            int(a[1] + (b[1] - a[1]) * t),
            int(a[2] + (b[2] - a[2]) * t))


def blend_theme(a, b, f):
    out = dict(b if f > 0.5 else a)
    for k in COLOR_KEYS:
        out[k] = mix(a[k], b[k], f)
    out["sparkle"] = (b if f > 0.5 else a)["sparkle"]
    return out


# --------------------------------------------------------------------------
# Curl noise (drives the steam wisps)
# --------------------------------------------------------------------------

def _h(i, j):
    n = (i * 1619 + j * 31337) & 0xFFFFFFFF
    n = ((n ^ (n >> 13)) * 1274126177) & 0xFFFFFFFF
    return ((n ^ (n >> 16)) & 0xFFFF) / 65535.0


def vnoise(x, y):
    ix, iy = math.floor(x), math.floor(y)
    fx, fy = x - ix, y - iy
    u = fx * fx * (3 - 2 * fx)
    v = fy * fy * (3 - 2 * fy)
    a, b = _h(ix, iy), _h(ix + 1, iy)
    c, d = _h(ix, iy + 1), _h(ix + 1, iy + 1)
    return a + (b - a) * u + (c - a) * v + (a - b - c + d) * u * v


def curl(x, y, e=0.6):
    dndy = (vnoise(x, y + e) - vnoise(x, y - e)) / (2 * e)
    dndx = (vnoise(x + e, y) - vnoise(x - e, y)) / (2 * e)
    return dndy, -dndx


