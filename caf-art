def fetch_weather(scene):
    def run():
        try:
            import urllib.request
            with urllib.request.urlopen("https://wttr.in/?format=%C", timeout=3) as r:
                cond = r.read().decode(errors="ignore").lower()
            if any(k in cond for k in ("rain", "drizzle", "shower", "thunder")):
                scene.weather = "rain"
            elif "snow" in cond or "sleet" in cond or "blizzard" in cond:
                scene.weather = "snow"
            elif "sun" in cond or "clear" in cond:
                scene.weather = "sun"
        except Exception:
            pass
    threading.Thread(target=run, daemon=True).start()


