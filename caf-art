def load_user_themes():
    path = os.path.expanduser("~/.config/caf/themes.toml")
    if not os.path.exists(path):
        return
    try:
        import tomllib
        with open(path, "rb") as f:
            data = tomllib.load(f)
        for key, spec in data.items():
            if not isinstance(spec, dict):
                continue
            theme = dict(THEMES["classic"])
            theme["name"] = spec.get("name", key.title())
            theme["icon"] = spec.get("icon", "☕")
            theme["sparkle"] = tuple(spec["sparkle"]) if "sparkle" in spec else None
            for ck in COLOR_KEYS:
                if ck in spec:
                    theme[ck] = tuple(int(v) for v in spec[ck])
            THEMES[key.lower()] = theme
    except Exception as e:
        print(f"caf: ignoring ~/.config/caf/themes.toml ({e})", file=sys.stderr)


