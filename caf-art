# --------------------------------------------------------------------------
# Ray-marched 3D cup (--3d): SDF scene, sphere-traced in pure Python
# --------------------------------------------------------------------------
# Cup wall and saucer are revolved polyline profiles (r, y) with a tube
# thickness; the handle is a squashed torus; the liquid is a capped disc
# whose normal is bump-mapped from the shallow-water simulation.

WALL3D = [(0.00, 0.06), (0.52, 0.06), (0.68, 0.10), (0.76, 0.20), (0.80, 1.00)]
SAUCER3D = [(0.00, -0.10), (1.02, -0.09), (1.22, -0.01)]
WALL_SEGS3D = [(a[0], a[1], b[0] - a[0], b[1] - a[1],
                (b[0] - a[0]) ** 2 + (b[1] - a[1]) ** 2)
               for a, b in zip(WALL3D, WALL3D[1:])]
SAUCER_SEGS3D = [(a[0], a[1], b[0] - a[0], b[1] - a[1],
                  (b[0] - a[0]) ** 2 + (b[1] - a[1]) ** 2)
                 for a, b in zip(SAUCER3D, SAUCER3D[1:])]
LIQ_R3D = 0.72


def sdf3d(x, y, z, liq_y):
    """Signed distance to the scene. Returns (distance, material 0/1/2)."""
    q = math.sqrt(x * x + z * z)
    best = 1e9
    for ax, ay, dx, dy, dd in WALL_SEGS3D:
        px, py = q - ax, y - ay
        h = (px * dx + py * dy) / dd
        h = 0.0 if h < 0.0 else (1.0 if h > 1.0 else h)
        ex, ey = px - dx * h, py - dy * h
        d = ex * ex + ey * ey
        if d < best:
            best = d
    d_cup = math.sqrt(best) - 0.05
    hx, hy = x - 0.92, (y - 0.55) * 1.15            # handle torus
    qq = math.sqrt(hx * hx + hy * hy) - 0.30
    d_han = math.sqrt(qq * qq + z * z) - 0.055
    if d_han < d_cup:
        d_cup = d_han
    best = 1e9
    for ax, ay, dx, dy, dd in SAUCER_SEGS3D:
        px, py = q - ax, y - ay
        h = (px * dx + py * dy) / dd
        h = 0.0 if h < 0.0 else (1.0 if h > 1.0 else h)
        ex, ey = px - dx * h, py - dy * h
        d = ex * ex + ey * ey
        if d < best:
            best = d
    d_sau = math.sqrt(best) - 0.045
    d_liq = y - liq_y                                # liquid: capped disc
    if q - LIQ_R3D > d_liq:
        d_liq = q - LIQ_R3D
    if 0.12 - y > d_liq:
        d_liq = 0.12 - y
    if d_liq < d_cup and d_liq < d_sau:
        return d_liq, 2
    if d_sau < d_cup:
        return d_sau, 1
    return d_cup, 0


def cam3d(yaw, pitch):
    """Camera eye + orthonormal basis for the orbit camera."""
    tx, ty, tz = 0.0, 0.55, 0.0
    dist = 3.4
    cp, sp = math.cos(pitch), math.sin(pitch)
    ex, ey, ez = tx + dist * cp * math.sin(yaw), ty + dist * sp, tz + dist * cp * math.cos(yaw)
    fx, fy, fz = tx - ex, ty - ey, tz - ez
    fl = math.sqrt(fx * fx + fy * fy + fz * fz)
    fx, fy, fz = fx / fl, fy / fl, fz / fl
    rx, rz = -fz, fx
    rl = math.sqrt(rx * rx + rz * rz)
    rx, rz = rx / rl, rz / rl
    ux, uy, uz = -rz * fy, rz * fx - rx * fz, rx * fy
    return ex, ey, ez, fx, fy, fz, rx, rz, ux, uy, uz


def cam_angles(scene):
    return (scene.yaw + scene.yaw_kick,
            max(0.10, min(0.98, scene.pitch + scene.pitch_kick)))


def project3d(scene, wx, wy, wz):
    """World point -> (col, half-block row) under the current orbit camera."""
    W, Hpx = scene.W, scene.H
    ex, ey, ez, fx, fy, fz, rx, rz, ux, uy, uz = cam3d(*cam_angles(scene))
    wx, wy, wz = wx - ex, wy - ey, wz - ez
    zc = wx * fx + wy * fy + wz * fz
    uc = (wx * rx + wz * rz) / zc * 1.9
    vc = (wx * ux + wy * uy + wz * uz) / zc * 1.9
    aspect = W / Hpx
    return ((uc / (aspect * 0.95) + 1) / 2 * W,
            (1 - (vc + 0.28) / 0.95) / 2 * Hpx)


def render3d(scene):
    """Sphere-trace the scene into a px buffer (None = background)."""
    Wf, Hf = scene.W, scene.H
    half = (Wf * Hf > 9000 and not scene.S) or Wf * Hf > 26000
    W, Hpx = (Wf // 2, Hf // 2) if half else (Wf, Hf)
    th = scene.theme
    cup_col, liq_col, crema, sauc_col = th["cup"], th["liquid"], th["crema"], th["saucer"]
    liq_y = 0.30 + 0.62 * scene.level
    ex, ey, ez, fx, fy, fz, rx, rz, ux, uy, uz = cam3d(*cam_angles(scene))
    lx, ly, lz = -0.4082, 0.7715, -0.4876            # normalized key light
    ws = scene.water.sample
    aspect = W / Hpx
    px = [[None] * W for _ in range(Hpx)]
    ocy = ey - 0.45
    c_sph = ex * ex + ocy * ocy + ez * ez - 2.6244   # bounding sphere r=1.62
    sdf = sdf3d
    for j in range(Hpx):
        v = (1 - (j + 0.5) / Hpx * 2) * 0.95 - 0.28
        row = px[j]
        dyv = fy * 1.9 + uy * v
        for i in range(W):
            u = ((i + 0.5) / W * 2 - 1) * aspect * 0.95
            dx = fx * 1.9 + rx * u + ux * v
            dy = dyv
            dz = fz * 1.9 + rz * u + uz * v
            dl = math.sqrt(dx * dx + dy * dy + dz * dz)
            dx, dy, dz = dx / dl, dy / dl, dz / dl
            b = ex * dx + ocy * dy + ez * dz
            disc = b * b - c_sph
            if disc < 0:
                continue
            sq = math.sqrt(disc)
            t1 = -b + sq
            if t1 < 0:
                continue
            t = max(-b - sq, 0.0)
            mat = -1
            for _ in range(48):
                pxx, pyy, pzz = ex + dx * t, ey + dy * t, ez + dz * t
                d, m = sdf(pxx, pyy, pzz, liq_y)
                if d < 0.0035 + 0.0015 * t:
                    mat = m
                    break
                t += d * 0.92
                if t > t1:
                    break
            if mat < 0:
                continue
            e = 0.004
            nx = sdf(pxx + e, pyy, pzz, liq_y)[0] - sdf(pxx - e, pyy, pzz, liq_y)[0]
            ny = sdf(pxx, pyy + e, pzz, liq_y)[0] - sdf(pxx, pyy - e, pzz, liq_y)[0]
            nz = sdf(pxx, pyy, pzz + e, liq_y)[0] - sdf(pxx, pyy, pzz - e, liq_y)[0]
            nl = math.sqrt(nx * nx + ny * ny + nz * nz) or 1.0
            nx, ny, nz = nx / nl, ny / nl, nz / nl
            if mat == 2:                              # bump-map from the water sim
                lu, lv = pxx / LIQ_R3D, pzz / LIQ_R3D
                gx = (ws(lu + 0.09, lv) - ws(lu - 0.09, lv)) * 1.4
                gz = (ws(lu, lv + 0.09) - ws(lu, lv - 0.09)) * 1.4
                nx -= gx
                nz -= gz
                nl = math.sqrt(nx * nx + ny * ny + nz * nz)
                nx, ny, nz = nx / nl, ny / nl, nz / nl
            diff = nx * lx + ny * ly + nz * lz
            if diff < 0:
                diff = 0.0
            hx_, hy_, hz_ = lx - dx, ly - dy, lz - dz
            hl = math.sqrt(hx_ * hx_ + hy_ * hy_ + hz_ * hz_) or 1.0
            spec = (nx * hx_ + ny * hy_ + nz * hz_) / hl
            spec = spec ** 40 if spec > 0 else 0.0
            fres = (1.0 - max(0.0, -(nx * dx + ny * dy + nz * dz))) ** 2
            if mat == 2:
                base = tuple(int(a + (b - a) * min(1.0, 0.18 + diff * 0.45 + spec * 0.6))
                             for a, b in zip(liq_col, crema))
                k = 0.38 + 0.7 * diff
            else:
                base = cup_col if mat == 0 else sauc_col
                k = 0.24 + 0.78 * diff
            row[i] = (min(255, int(base[0] * k + 200 * spec + 26 * fres)),
                      min(255, int(base[1] * k + 200 * spec + 26 * fres)),
                      min(255, int(base[2] * k + 200 * spec + 30 * fres)))
    if half:
        jm, im = Hpx - 1, W - 1
        return [[px[min(j // 2, jm)][min(i // 2, im)] for i in range(Wf)]
                for j in range(Hf)]
    return px


# --------------------------------------------------------------------------
# Shallow-water surface simulation
# --------------------------------------------------------------------------

WGW, WGH = 54, 26


class Water:
    """Height-field wave sim on an elliptical grid; walls reflect."""

    def __init__(self):
        self.h = [[0.0] * WGW for _ in range(WGH)]
        self.v = [[0.0] * WGW for _ in range(WGH)]
        self.mask = [[False] * WGW for _ in range(WGH)]
        for gy in range(WGH):
            for gx in range(WGW):
                u = gx / (WGW - 1) * 2 - 1
                w = gy / (WGH - 1) * 2 - 1
                self.mask[gy][gx] = u * u + w * w <= 1.0

    def step(self):
        h, v, mask = self.h, self.v, self.mask
        for gy in range(WGH):
            hrow, vrow, mrow = h[gy], v[gy], mask[gy]
            up = h[gy - 1] if gy > 0 else hrow
            dn = h[gy + 1] if gy < WGH - 1 else hrow
            for gx in range(WGW):
                if not mrow[gx]:
                    continue
                c = hrow[gx]
                # out-of-mask neighbors mirror the cell -> reflecting wall
                left = hrow[gx - 1] if gx > 0 and mrow[gx - 1] else c
                right = hrow[gx + 1] if gx < WGW - 1 and mrow[gx + 1] else c
                above = up[gx] if mask[gy - 1][gx] and gy > 0 else c
                below = dn[gx] if gy < WGH - 1 and mask[gy + 1][gx] else c
                force = (left + right + above + below) / 4 - c
                vrow[gx] = (vrow[gx] + force * 0.55) * 0.985
        for gy in range(WGH):
            hrow, vrow, mrow = h[gy], v[gy], mask[gy]
            for gx in range(WGW):
                if mrow[gx]:
                    hrow[gx] = (hrow[gx] + vrow[gx]) * 0.999

    def disturb(self, u, w, amp, rad=0.14):
        cx = (u + 1) / 2 * (WGW - 1)
        cy = (w + 1) / 2 * (WGH - 1)
        r = max(1, int(rad * WGW))
        for gy in range(max(0, int(cy) - r), min(WGH, int(cy) + r + 1)):
            for gx in range(max(0, int(cx) - r), min(WGW, int(cx) + r + 1)):
                if self.mask[gy][gx]:
                    d2 = ((gx - cx) / r) ** 2 + ((gy - cy) / r) ** 2
                    if d2 < 1:
                        self.h[gy][gx] += amp * math.exp(-d2 * 3)

    def sample(self, u, w):
        gx = min(WGW - 1.001, max(0.0, (u + 1) / 2 * (WGW - 1)))
        gy = min(WGH - 1.001, max(0.0, (w + 1) / 2 * (WGH - 1)))
        ix, iy = int(gx), int(gy)
        fx, fy = gx - ix, gy - iy
        h = self.h
        a = h[iy][ix] + (h[iy][ix + 1] - h[iy][ix]) * fx
        b = h[iy + 1][ix] + (h[iy + 1][ix + 1] - h[iy + 1][ix]) * fx
        return a + (b - a) * fy


