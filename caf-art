    print("\x1b[1mPresets:\x1b[0m " + ", ".join(THEMES) + "  (aliases: " + ", ".join(ALIASES) + ")")
    print("\x1b[1mKeys:\x1b[0m s = sip, space = stir, x = nudge the cup, w = write the time,")
    print("      t = theme, q = quit; --3d adds arrows = orbit, o = auto-orbit")
    print("\x1b[1mThemes file:\x1b[0m ~/.config/caf/themes.toml")
    print("\x1b[1mIMU:\x1b[0m auto-detected on M2+ MacBooks — real tilt slants the coffee (tip far")
    print("     enough and it spills; the cup can slide off the saucer and hit the floor),")
    print("     shoves slosh it, spinning steers the 3D camera, and the ambient light")
    print("     sensor dims the scene with your room. caf-art --imu-debug [secs] shows")
    print("     live samples; caf-art --imu-bridge runs the sensor bridge manually.")
    print("\x1b[1mSound:\x1b[0m --sound adds procedural foley (clink/glug/slurp/crash) via afplay.")


def main():
    load_user_themes()
    args = list(sys.argv[1:])
    demo_frames = 0
    demo_size = None
    no_caf = False
    preset = "classic"
    pomo_min = 0
    zen = False
    hires = False
    weather = False
    three_d = False
    sound = False
    i = 0
    while i < len(args):
        a = args[i]
        if a in ("help", "-h", "--help"):
            usage(); return 0
        elif a == "--demo":
            demo_frames = int(args[i + 1]); i += 1
        elif a == "--size":
            w, h = args[i + 1].split("x"); demo_size = (int(w), int(h)); i += 1
        elif a == "--no-caffeinate":
            no_caf = True
        elif a in ("--pomodoro", "pomo"):
            pomo_min = int(args[i + 1]); i += 1
        elif a == "--zen":
            zen = True
        elif a == "--hires":
            hires = True
        elif a == "--weather":
            weather = True
        elif a == "--3d":
            three_d = True
        elif a == "--sound":
            sound = True
        elif a == "--imu-bridge":
            return imu_bridge(quiet="--quiet" in args)
        elif a == "--quiet":
            pass
        elif a == "--imu-debug":
            secs = 6
            if i + 1 < len(args) and args[i + 1].isdigit():
                secs = int(args[i + 1]); i += 1
            return imu_bridge(debug_secs=secs)
        else:
            preset = ALIASES.get(a, a)
        i += 1
    if preset not in THEMES:
        preset = "classic"

    caf_proc = None
    if not no_caf and not demo_frames and shutil.which("caffeinate"):
        caf_proc = subprocess.Popen(["caffeinate", "-d"],
                                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    # auto-start the IMU bridge so real laptop motion just works (M2+; the
    # bridge exits harmlessly on machines without the sensor)
    imu_proc = None
    if not demo_frames and sys.platform == "darwin":
        s = imu_read_sample()
        if not s or abs(time.monotonic() - s[0]) > 0.6:
            try:
                imu_proc = subprocess.Popen(
                    [os.path.abspath(__file__), "--imu-bridge", "--quiet"],
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except OSError:
                imu_proc = None

    interactive = demo_frames == 0
    keyboard = interactive and sys.stdin.isatty()
    S = (2 if three_d else 4) if hires else 0
    scene = Scene(preset, hires_scale=S)
    scene.mode3d = three_d
    if sound and not demo_frames:
        kit = SoundKit()
        if kit.ok:
            scene.snd = kit.play
    scene._sample_heat()
    if weather:
        fetch_weather(scene)
    start = time.monotonic()

    pomo_phase = "work"
    pomo_end = start + pomo_min * 60 if pomo_min else None
    zen_switch = start + 150
    zen_fade = None      # (from_theme, to_key, t0)

    old_termios = None
    if keyboard:
        import termios
        import tty
        stdin_fd = sys.stdin.fileno()
        old_termios = termios.tcgetattr(stdin_fd)
        tty.setcbreak(stdin_fd)

    def cleanup():
        if caf_proc:
            caf_proc.terminate()
        if imu_proc:
            imu_proc.terminate()
        if old_termios is not None:
            import termios
            termios.tcsetattr(sys.stdin.fileno(), termios.TCSADRAIN, old_termios)
        if interactive:
            sys.stdout.write("\x1b[0m\x1b[?25h\x1b[?1049l")
            sys.stdout.flush()

    signal.signal(signal.SIGINT, signal.default_int_handler)
    signal.signal(signal.SIGTERM, lambda *_: (_ for _ in ()).throw(KeyboardInterrupt))

    if interactive:
        sys.stdout.write("\x1b[?1049h\x1b[?25l\x1b[2J")

    last_size = None
    frame_n = 0
    prev_lines = None
    prev_status = None
    prev_sparkle_rows = set()
    last_word_stamp = None
    stdin_buf = ""
    imu_at = 0.0
    imu_prev_t = None
    imu_active = False
    win_prev = None          # (t, x, y) last window position report
    win_query_at = 0.0
    WIN_RE = re.compile(r"\x1b\[3;(-?\d+);(-?\d+)t")
    CSI_RE = re.compile(r"\x1b\[[0-9;?]*[A-Za-z~]")
    try:
        while True:
            now = time.monotonic()
            cols, rows = (demo_size or shutil.get_terminal_size())
            cols, rows = max(20, cols), max(8, rows)
            if (cols, rows) != last_size:
                if last_size:
                    scene.gust(cols - last_size[0])
                if S:
                    scene.layout(cols * S, (rows - 1) * S + 1)
                else:
                    scene.layout(cols, rows)
                last_size = (cols, rows)
                prev_lines = prev_status = None
                if interactive:
                    sys.stdout.write("\x1b[2J")
                scene.particles = [p for p in scene.particles
                                   if p[1] < scene.cup_top + scene.rim_h]

            if keyboard:
                if now - win_query_at > 0.15:        # poll window position
                    win_query_at = now
                    sys.stdout.write("\x1b[13t")
                    sys.stdout.flush()
                while select.select([sys.stdin], [], [], 0)[0]:
                    chunk = os.read(sys.stdin.fileno(), 256).decode(errors="ignore")
                    if not chunk:
                        break
                    stdin_buf += chunk
                reports = WIN_RE.findall(stdin_buf)
                if reports:
                    wx, wy = int(reports[-1][0]), int(reports[-1][1])
                    if win_prev is not None:
                        dtw = now - win_prev[0]
                        if 0 < dtw < 1.0:
                            vx = (wx - win_prev[1]) / dtw
                            vy = (wy - win_prev[2]) / dtw
                            if abs(vx) + abs(vy) > 40:
                                scene.window_motion(vx, vy)
                    win_prev = (now, wx, wy)
                    stdin_buf = WIN_RE.sub("", stdin_buf)
                if three_d:
                    scene.yaw += 0.18 * (stdin_buf.count("\x1b[D") - stdin_buf.count("\x1b[C"))
                    scene.pitch = max(0.12, min(0.95, scene.pitch
                                                + 0.08 * (stdin_buf.count("\x1b[A") - stdin_buf.count("\x1b[B"))))
                    if "o" in CSI_RE.sub("", stdin_buf):
                        scene.auto_orbit = not scene.auto_orbit
                plain = CSI_RE.sub("", stdin_buf)
                tail = re.search(r"\x1b(\[[0-9;?]*)?$", stdin_buf)
                stdin_buf = tail.group(0) if tail else ""
                for ch in plain:
                    if ch == "s":
                        scene.sip(pomo=bool(pomo_end))
                    elif ch == " ":
                        scene.stir()
                    elif ch == "x":
                        scene.nudge()
                    elif ch == "w":
                        scene.write_word(time.strftime("%H:%M"))
                    elif ch == "t":
                        scene.cycle_theme()
                        prev_lines = prev_status = None
                    elif ch == "q":
                        raise KeyboardInterrupt

            if cols < 26 or rows < 10:
                if interactive:
                    msg = f"{scene.theme['icon']} zzz… (terminal too small, still caffeinated)"
                    sys.stdout.write(f"\x1b[H\x1b[2J\x1b[{rows // 2};1H" + msg[:cols].center(cols))
                    sys.stdout.flush()
                    time.sleep(0.5)
                    scene.t += 0.5
                    prev_lines = prev_status = None
                    continue

            # real IMU samples, if a bridge is running
            if interactive and now - imu_at > 0.06:
                imu_at = now
                s = imu_read_sample()
                if s and abs(now - s[0]) < 0.6 and s[0] != imu_prev_t:
                    scene.imu_input(s[1], s[2], now - (imu_prev_t or now - 0.07))
                    if s[3] >= 0.0:
                        scene.ambient_light(s[3], now - (imu_prev_t or now - 0.07))
                    imu_prev_t = s[0]
                    imu_active = True
                elif not s or abs(now - s[0]) >= 0.6:
                    if imu_active:
                        scene.tilt_in = (0.0, 0.0)
                    imu_active = False

            # pomodoro drives the level
            extra = ""
            if pomo_end:
                rem = pomo_end - now
                if rem <= 0:
                    sys.stdout.write("\a")
                    if scene.snd:
                        scene.snd("chime", 0.6)
                    if pomo_phase == "work":
                        pomo_phase = "break"
                        pomo_end = now + 5 * 60
                        scene.write_word("BREAK")
                    else:
                        pomo_phase = "work"
                        pomo_end = now + pomo_min * 60
                        scene.write_word("GO")
                    rem = pomo_end - now
                total = 5 * 60 if pomo_phase == "break" else pomo_min * 60
                frac = max(0.0, min(1.0, rem / total))
                scene.target_level = max(0.05, frac if pomo_phase == "work" else 1 - frac)
                pm, ps = divmod(int(rem), 60)
                extra = f" · \U0001f345 {pomo_phase} {pm:02d}:{ps:02d}"
            elif not zen and not scene.word:
                # steam writes the time every 10 minutes
                lt = time.localtime()
                stamp = (lt.tm_hour, lt.tm_min)
                if lt.tm_min % 10 == 0 and lt.tm_sec < 2 and stamp != last_word_stamp:
                    last_word_stamp = stamp
                    scene.write_word(time.strftime("%H:%M"))

            if imu_active:
                extra += " · imu"

            # zen: slow theme crossfade + occasional auto-stir
            if zen:
                if zen_fade is None and now > zen_switch:
                    keys = list(THEMES)
                    nxt = keys[(keys.index(scene.theme_key) + 1) % len(keys)]
                    zen_fade = (dict(scene.theme), nxt, now)
                if zen_fade:
                    f = (now - zen_fade[2]) / 3.0
                    if f >= 1:
                        scene.theme_key = zen_fade[1]
                        scene.theme = THEMES[zen_fade[1]]
                        zen_fade = None
                        zen_switch = now + 150
                        prev_lines = None
                    else:
                        scene.theme = blend_theme(zen_fade[0], THEMES[zen_fade[1]], f)
                if random.random() < 0.0005:
                    scene.stir()

            dt = (0.15 if three_d else 0.1) if S else 0.066
            scene.t += dt
            scene.step(dt)
            px, sgrid = scene.draw()
            status = scene.status(now - start, keyboard, extra, zen, width=cols)

            if S:
                png = px_to_png(px, scene.W, scene.H)
                buf = kitty_emit(png, cols, rows - 1)
                if status != prev_status:
                    buf += f"\x1b[{rows};1H\x1b[2K{status}"
                prev_status = status
            else:
                lines, overlay = scene.blit(px, sgrid)
                if prev_lines is None or not interactive:
                    buf = "\x1b[H" + "\n".join(lines) + "\n" + status + overlay
                else:
                    parts = []
                    for idx, line in enumerate(lines):
                        if idx >= len(prev_lines) or prev_lines[idx] != line or idx in prev_sparkle_rows:
                            parts.append(f"\x1b[{idx + 1};1H{line}")
                    if status != prev_status:
                        parts.append(f"\x1b[{rows};1H\x1b[2K{status}")
                    parts.append(overlay)
                    buf = "".join(parts)
                prev_lines, prev_status = lines, status
                prev_sparkle_rows = {r for _, r, _ in scene.sparkles}
            sys.stdout.write(buf)
            sys.stdout.flush()

            frame_n += 1
            if demo_frames and frame_n >= demo_frames:
                print()
                return 0
            time.sleep(dt)
    except KeyboardInterrupt:
        pass
    finally:
        cleanup()
    m, s = divmod(int(time.monotonic() - start), 60)
    extra = f", {scene.sips} sip{'s' if scene.sips != 1 else ''}" if scene.sips else ""
    print(f"\x1b[1;31m \U0001f6d1 Decaffeinated.\x1b[0m \x1b[2m(awake for {m}m {s:02d}s{extra})\x1b[0m")
    return 0


if __name__ == "__main__":
    sys.exit(main())
