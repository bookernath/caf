def main():
    load_user_themes()
    args = list(sys.argv[1:])
    demo_frames = 0
    demo_size = None
    no_caf = False
    no_lid_guard = False
    preset = "diner"
    renderer_mode = "auto"
    fluid_mode = "apic"
    cup_motion = True
    cinematic = True
    ansi = False
    auto_level = False
    dither = True
    pomo_min = 0
    zen = False
    hires = False
    weather = False
    three_d = True
    sound = False
    i = 0
    while i < len(args):
        a = args[i]
        if a in ("help", "-h", "--help"):
            usage(); return 0
        elif a == "--demo":
            demo_frames = int(args[i + 1]); i += 1
        elif a == "--size":
            w, h = args[i + 1].split("x"); demo_size = (int(w), int(h)); i += 1
        elif a == "--no-caffeinate":
            no_caf = True
        elif a == "--no-lid-guard":
            no_lid_guard = True
        elif a in ("--pomodoro", "pomo"):
            pomo_min = int(args[i + 1]); i += 1
        elif a == "--zen":
            zen = True
        elif a == "--hires":
            hires = True
        elif a == "--ansi":
            ansi = True
        elif a == "--renderer":
            if i+1 >= len(args) or args[i+1] not in ("auto", "metal", "cpu"):
                print("caf: --renderer expects auto, metal, or cpu", file=sys.stderr)
                return 2
            renderer_mode = args[i+1]; i += 1
        elif a == "--fluid":
            if i+1 >= len(args) or args[i+1] not in ("apic", "legacy"):
                print("caf: --fluid expects apic or legacy", file=sys.stderr)
                return 2
            fluid_mode = args[i+1]; i += 1
        elif a == "--cup":
            if i+1 >= len(args) or args[i+1] not in ("free", "locked"):
                print("caf: --cup expects free or locked", file=sys.stderr)
                return 2
            cup_motion = args[i+1] == "free"; i += 1
        elif a == "--studio":
            cinematic = False
        elif a == "--smooth":
            dither = False
        elif a == "--auto-level":
            auto_level = True
        elif a == "--calibrate":
            return calibration_wizard(imu_read_sample, imu_start_bridge)
        elif a == "--weather":
            weather = True
        elif a == "--3d":
            three_d = True
        elif a in ("--2d", "--flat"):
            three_d = False
        elif a == "--sound":
            sound = True
        elif a == "--imu-bridge":
            return imu_bridge(quiet="--quiet" in args)
        elif a == "--quiet":
            pass
        elif a == "--imu-debug":
            secs = 6
            if i + 1 < len(args) and args[i + 1].isdigit():
                secs = int(args[i + 1]); i += 1
            return imu_bridge(debug_secs=secs)
        elif a == "--imu-tilt":
            secs = 30
            if i + 1 < len(args) and args[i + 1].isdigit():
                secs = int(args[i + 1]); i += 1
            return imu_tilt_debug(secs)
        else:
            preset = ALIASES.get(a, a)
        i += 1
    if preset not in THEMES:
        preset = "diner"

    caf_proc = None
    if not no_caf and not demo_frames and shutil.which("caffeinate"):
        caf_proc = subprocess.Popen(["caffeinate", "-d"],
                                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    # caffeinate only files power assertions, and lid close is a separate
    # hardware sleep path that ignores them — so hand the session off to
    # caf-lid-guard, which flips the kernel SleepDisabled flag and drops it
    # again as soon as this pid dies. Run before the alt screen so its one
    # sudo prompt lands on a normal terminal.
    lid_guard = None
    guard_bin = os.path.expanduser("~/.local/bin/caf-lid-guard")
    if (not no_caf and not no_lid_guard and not demo_frames
            and sys.platform == "darwin"
            and os.getenv("CAF_NO_LID_GUARD") not in ("1", "true")
            and os.access(guard_bin, os.X_OK)):
        try:
            if subprocess.call([guard_bin, "on", str(os.getpid())]) == 0:
                lid_guard = guard_bin
        except (OSError, KeyboardInterrupt):
            lid_guard = None

    # auto-start the IMU bridge so real laptop motion just works
    imu_proc = None if demo_frames else imu_start_bridge()

    interactive = demo_frames == 0
    keyboard = interactive and sys.stdin.isatty()
    S = (2 if three_d else 4) if hires else 0
    scene = Scene(preset, hires_scale=S)
    scene.mode3d = three_d
    scene.auto_level = auto_level
    scene.cup_motion = cup_motion
    scene.cinematic = cinematic
    kit = None
    if sound and not demo_frames:
        kit = SoundKit()
        if kit.ok:
            scene.snd = kit.play
    scene._sample_heat()
    if weather:
        fetch_weather(scene)
    start = time.monotonic()

    pomo_phase = "work"
    pomo_end = start + pomo_min * 60 if pomo_min else None
    zen_switch = start + 150
    zen_fade = None      # (from_theme, to_key, t0)

    old_termios = None
    if keyboard:
        import termios
        import tty
        stdin_fd = sys.stdin.fileno()
        old_termios = termios.tcgetattr(stdin_fd)
        tty.setcbreak(stdin_fd)

    gpu = None
    sensors = None
    startup_input = ""

    def cleanup():
        if kit:
            kit.close()
        if sensors:
            sensors.close()
        if gpu:
            gpu.close()
        if lid_guard:
            # fire and forget — the guard's root watchdog also notices this pid
            # dying on its own, so a hard kill still restores the flag
            try:
                subprocess.Popen([lid_guard, "off", str(os.getpid())],
                                 stdout=subprocess.DEVNULL,
                                 stderr=subprocess.DEVNULL)
            except OSError:
                pass
        if caf_proc:
            caf_proc.terminate()
        if imu_proc:
            imu_proc.terminate()
        if old_termios is not None:
            import termios
            termios.tcsetattr(sys.stdin.fileno(), termios.TCSADRAIN, old_termios)
        if interactive:
            sys.stdout.write("\x1b_Ga=d,d=I,i=99,q=2;\x1b\\" if S or gpu else "")
            if keyboard:
                sys.stdout.write("\x1b[?1004l")
            sys.stdout.write("\x1b[0m\x1b[?25h\x1b[?1049l")
            sys.stdout.flush()

    signal.signal(signal.SIGINT, signal.default_int_handler)
    signal.signal(signal.SIGTERM, lambda *_: (_ for _ in ()).throw(KeyboardInterrupt))

    try:
        supported = False
        if not ansi and interactive:
            supported, startup_input = probe_terminal(sys.stdin, sys.stdout)
        elif not ansi and demo_frames:
            supported = hires or renderer_mode == "metal"
        wants_gpu = three_d and renderer_mode != "cpu" and not ansi and supported
        if wants_gpu:
            try:
                gpu = MetalRenderer()
                scene.real_fluid = fluid_mode == "apic"
            except OSError as exc:
                if renderer_mode == "metal":
                    print(f"caf: {exc}; using CPU renderer", file=sys.stderr)
        elif renderer_mode == "metal" and not supported:
            print("caf: terminal did not confirm image support; using ANSI", file=sys.stderr)
        S = 0 if gpu else ((2 if three_d else 4) if hires and supported and not ansi else 0)
        scene.S = S
        sensors = SensorSamples(imu_read_sample) if interactive else None
    except BaseException:
        cleanup()
        raise
    if interactive:
        sys.stdout.write("\x1b[?1049h\x1b[?25l\x1b[2J")
        if keyboard:
            sys.stdout.write("\x1b[?1004h")
        sys.stdout.flush()

    focused = True  # unsupported terminals keep running; never guess focus
    last_size = None
    frame_n = 0
    prev_lines = None
    prev_status = None
    prev_sparkle_rows = set()
    last_word_stamp = None
    stdin_buf = startup_input
    frame_previous = time.monotonic()
    sim_accumulator = 0.0
    imu_prev_t = None
    imu_active = False
    imu_resuming = False
    win_prev = None          # (t, x, y) last window position report
    win_query_at = 0.0
    WIN_RE = re.compile(r"\x1b\[3;(-?\d+);(-?\d+)t")
    CSI_RE = re.compile(r"\x1b\[[0-9;?]*[A-Za-z~]")
    try:
        while True:
            now = time.monotonic()
            elapsed_frame = min(.25, max(0., now-frame_previous))
            frame_previous = now
            cols, rows = (demo_size or shutil.get_terminal_size())
            cols, rows = max(20, cols), max(8, rows)

            if keyboard:
                if focused and now - win_query_at > 0.15:        # poll window position
                    win_query_at = now
                    sys.stdout.write("\x1b[13t")
                    sys.stdout.flush()
                while select.select([sys.stdin], [], [], 0)[0]:
                    chunk = os.read(sys.stdin.fileno(), 256).decode(errors="ignore")
                    if not chunk:
                        raise KeyboardInterrupt
                    stdin_buf += chunk
                # A fragmented/late graphics reply must never become sip/theme/quit keys.
                apc_tail = ""
                apc_at = stdin_buf.find("\x1b_G")
                while apc_at >= 0:
                    apc_end = stdin_buf.find("\x1b\\", apc_at)
                    if apc_end < 0:
                        apc_tail, stdin_buf = stdin_buf[apc_at:], stdin_buf[:apc_at]
                        break
                    stdin_buf = stdin_buf[:apc_at] + stdin_buf[apc_end+2:]
                    apc_at = stdin_buf.find("\x1b_G")
                focus_reports = re.findall(r"\x1b\[([IO])", stdin_buf)
                if focus_reports:
                    new_focus = focus_reports[-1] == "I"
                    if new_focus != focused:
                        focused = new_focus
                        if sensors:
                            sensors.set_paused(not focused)
                        if not focused and kit:
                            kit.close()  # stop existing incidental voices, keep kit reusable
                        scene.snd = kit.play if focused and kit and kit.ok else None
                        sim_accumulator = elapsed_frame = 0.0
                        frame_previous = now
                        imu_prev_t = win_prev = None
                        imu_active = False
                        scene.fluid_accel = (0., 0., 0.)
                        if focused:
                            imu_resuming = True
                            prev_lines = prev_status = None
                    stdin_buf = re.sub(r"\x1b\[[IO]", "", stdin_buf)
                reports = WIN_RE.findall(stdin_buf)
                if reports:
                    wx, wy = int(reports[-1][0]), int(reports[-1][1])
                    if focused and win_prev is not None:
                        dtw = now - win_prev[0]
                        if 0 < dtw < 1.0:
                            vx = (wx - win_prev[1]) / dtw
                            vy = (wy - win_prev[2]) / dtw
                            if abs(vx) + abs(vy) > 40:
                                scene.window_motion(vx, vy)
                    win_prev = (now, wx, wy)
                    stdin_buf = WIN_RE.sub("", stdin_buf)
                if three_d and focused:
                    scene.yaw += 0.18 * (stdin_buf.count("\x1b[D") - stdin_buf.count("\x1b[C"))
                    scene.pitch = max(0.12, min(0.95, scene.pitch
                                                + 0.08 * (stdin_buf.count("\x1b[A") - stdin_buf.count("\x1b[B"))))
                    if "o" in CSI_RE.sub("", stdin_buf):
                        scene.auto_orbit = not scene.auto_orbit
                plain = CSI_RE.sub("", stdin_buf)
                tail = re.search(r"\x1b(\[[0-9;?]*)?$", stdin_buf)
                stdin_buf = (tail.group(0) if tail else "") + apc_tail
                for ch in plain:
                    if not focused and ch != "q":
                        continue
                    if ch == "s":
                        scene.sip(pomo=bool(pomo_end))
                    elif ch == "f":
                        scene.refill()
                    elif ch == "r":
                        scene.reset_fluid()
                    elif ch == "m":
                        scene.add_cream()
                    elif ch == "k":
                        scene.knock_over()
                    elif ch == "l":
                        scene.cinematic = not scene.cinematic
                    elif ch == " ":
                        scene.stir()
                    elif ch == "x":
                        scene.nudge()
                    elif ch == "z":
                        scene.imu_level()
                    elif ch == "w":
                        scene.write_word(time.strftime("%H:%M"))
                    elif ch == "t":
                        scene.cycle_theme()
                        prev_lines = prev_status = None
                    elif ch == "q":
                        raise KeyboardInterrupt

            # Drain timestamped samples buffered independently of expensive drawing.
            for sample in sensors.drain() if sensors and focused else ():
                if abs(now-sample[0]) >= .6:
                    continue
                sample_dt = sample[0] - imu_prev_t if imu_prev_t is not None else .01
                if sample_dt <= 0:
                    continue
                if imu_resuming:
                    scene.resume_imu(sample[1])
                    imu_resuming = False
                    # Reacquire current pose, not a stale inter-focus impulse.
                    scene.imu_input(sample[1], (0., 0., 0.), sample_dt)
                    scene.fluid_accel = (0., 0., 0.)
                else:
                    scene.imu_input(sample[1], sample[2], sample_dt)
                if sample[3] >= 0.:
                    scene.ambient_light(sample[3], sample_dt)
                imu_prev_t = sample[0]
                imu_active = True
            if imu_active and (imu_prev_t is None or now-imu_prev_t >= .6):
                scene.tilt_in = (0., 0.)
                scene.roll = 0.
                scene.gravity = (0., -1., 0.)
                scene.fluid_accel = (0., 0., 0.)
                imu_active = False

            # pomodoro drives the level
            extra = ""
            if pomo_end:
                rem = pomo_end - now
                if rem <= 0:
                    sys.stdout.write("\a")
                    sys.stdout.flush()
                    if scene.snd:
                        scene.snd("chime", 0.6)
                    if pomo_phase == "work":
                        pomo_phase = "break"
                        pomo_end = now + 5 * 60
                        scene.write_word("BREAK")
                    else:
                        pomo_phase = "work"
                        pomo_end = now + pomo_min * 60
                        scene.write_word("GO")
                    rem = pomo_end - now
                total = 5 * 60 if pomo_phase == "break" else pomo_min * 60
                frac = max(0.0, min(1.0, rem / total))
                scene.target_level = max(0.05, frac if pomo_phase == "work" else 1 - frac)
                if scene.real_fluid and focused:
                    # Remove only excess coffee during work; never undo a spill.
                    # Break refill is an explicit bounded source, not scalar healing.
                    scene.fluid_events.append({"kind": "target", "level": scene.target_level,
                                               "fill": pomo_phase == "break"})
                pm, ps = divmod(int(rem), 60)
                extra = f" · \U0001f345 {pomo_phase} {pm:02d}:{ps:02d}"
            elif not zen and not scene.word:
                # steam writes the time every 10 minutes
                lt = time.localtime()
                stamp = (lt.tm_hour, lt.tm_min)
                if lt.tm_min % 10 == 0 and lt.tm_sec < 2 and stamp != last_word_stamp:
                    last_word_stamp = stamp
                    scene.write_word(time.strftime("%H:%M"))

            if not focused:
                # Keep wall-clock Pomodoro and power assertions alive, but do no
                # drawing, physics, position queries, heat sampling or foley.
                # select wakes immediately on focus-in/quit; timers tick at 1 Hz.
                sim_accumulator = 0.0
                select.select([sys.stdin], [], [], 1.0)
                frame_previous = time.monotonic()
                continue

            if (cols, rows) != last_size:
                if last_size:
                    scene.gust(cols - last_size[0])
                if S:
                    scene.layout(cols * S, (rows - 1) * S + 1)
                else:
                    scene.layout(cols, rows)
                last_size = (cols, rows)
                prev_lines = prev_status = None
                if interactive:
                    sys.stdout.write("\x1b[2J")
                scene.particles = [p for p in scene.particles
                                   if p[1] < scene.cup_top + scene.rim_h]


            if cols < 26 or rows < 10:
                if interactive:
                    msg = f"{scene.theme['icon']} zzz… (terminal too small, still caffeinated)"
                    sys.stdout.write(f"\x1b[H\x1b[2J\x1b[{rows // 2};1H" + msg[:cols].center(cols))
                    sys.stdout.flush()
                    time.sleep(0.5)
                    scene.t += 0.5
                    prev_lines = prev_status = None
                    continue

            if imu_active:
                extra += " · imu" + (" calibrated" if scene._calibration else "")
            if gpu:
                extra += " · metal"

            # zen: slow theme crossfade + occasional auto-stir
            if zen:
                if zen_fade is None and now > zen_switch:
                    keys = list(THEMES)
                    nxt = keys[(keys.index(scene.theme_key) + 1) % len(keys)]
                    zen_fade = (dict(scene.theme), nxt, now)
                if zen_fade:
                    f = (now - zen_fade[2]) / 3.0
                    if f >= 1:
                        scene.theme_key = zen_fade[1]
                        scene.theme = THEMES[zen_fade[1]]
                        zen_fade = None
                        zen_switch = now + 150
                        prev_lines = None
                    else:
                        scene.theme = blend_theme(zen_fade[0], THEMES[zen_fade[1]], f)
                if random.random() < 0.0005:
                    scene.stir()

            frame_budget = 1/30 if gpu else (.10 if S else 1/15)
            sim_accumulator += frame_budget if demo_frames else elapsed_frame
            while sim_accumulator >= 1/30:
                scene.t += 1/30
                scene.step(1/30)
                sim_accumulator -= 1/30
            png = None
            if gpu:
                try:
                    gw, gh = dimensions(cols, rows)
                    png = rgb_png(gw, gh, gpu.render(scene, gw, gh, dither))
                except (OSError, ValueError):
                    gpu.close()
                    gpu = None
                    scene.real_fluid = False
                    scene.target_level = scene.level
                    scene.fluid_events.clear()
                    scene.S = S = 0
                    last_size = None
                    prev_lines = prev_status = None
                    scene.layout(cols, rows)
                    sys.stdout.write("\x1b_Ga=d,d=I,i=99,q=2;\x1b\\\x1b[2J")
                    extra += " · GPU stopped; CPU fallback"
            if png is None:
                px, sgrid = scene.draw()
            status = scene.status(now - start, keyboard, extra, zen, width=cols)

            if png is not None or S:
                if png is None:
                    png = px_to_png(px, scene.W, scene.H)
                buf = kitty_emit(png, cols, rows - 1)
                if status != prev_status:
                    buf += f"\x1b[{rows};1H\x1b[2K{status}"
                prev_status = status
            else:
                lines, overlay = scene.blit(px, sgrid)
                if prev_lines is None or not interactive:
                    buf = "\x1b[H" + "\n".join(lines) + "\n" + status + overlay
                else:
                    parts = []
                    for idx, line in enumerate(lines):
                        if idx >= len(prev_lines) or prev_lines[idx] != line or idx in prev_sparkle_rows:
                            parts.append(f"\x1b[{idx + 1};1H{line}")
                    if status != prev_status:
                        parts.append(f"\x1b[{rows};1H\x1b[2K{status}")
                    parts.append(overlay)
                    buf = "".join(parts)
                prev_lines, prev_status = lines, status
                prev_sparkle_rows = {r for _, r, _ in scene.sparkles}
            sys.stdout.write(buf)
            sys.stdout.flush()

            frame_n += 1
            if demo_frames and frame_n >= demo_frames:
                print()
                return 0
            # sleep out the rest of the frame, not another whole one: the 3d
            # march costs ~30 ms and sim time is supposed to track wall time
            time.sleep(max(0.004, frame_budget - (time.monotonic() - now)))
    except KeyboardInterrupt:
        pass
    finally:
        cleanup()
    m, s = divmod(int(time.monotonic() - start), 60)
    extra = f", {scene.sips} sip{'s' if scene.sips != 1 else ''}" if scene.sips else ""
    print(f"\x1b[1;31m \U0001f6d1 Decaffeinated.\x1b[0m \x1b[2m(awake for {m}m {s:02d}s{extra})\x1b[0m")
    return 0


if __name__ == "__main__":
    sys.exit(main())
