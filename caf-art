# --------------------------------------------------------------------------
# Ray-marched 3D cup (--3d): SDF scene, sphere-traced in pure Python
# --------------------------------------------------------------------------
# Cup wall and saucer are revolved polyline profiles (r, y) with a tube
# thickness; the handle is a squashed torus; the liquid is a capped disc
# whose normal is bump-mapped from the shallow-water simulation.

WALL3D = [(0.00, 0.06), (0.52, 0.06), (0.68, 0.10), (0.76, 0.20), (0.80, 1.00)]
SAUCER3D = [(0.00, -0.10), (1.02, -0.09), (1.22, -0.01)]
WALL_SEGS3D = [(a[0], a[1], b[0] - a[0], b[1] - a[1],
                (b[0] - a[0]) ** 2 + (b[1] - a[1]) ** 2)
               for a, b in zip(WALL3D, WALL3D[1:])]
SAUCER_SEGS3D = [(a[0], a[1], b[0] - a[0], b[1] - a[1],
                  (b[0] - a[0]) ** 2 + (b[1] - a[1]) ** 2)
                 for a, b in zip(SAUCER3D, SAUCER3D[1:])]
LIQ_R3D = 0.72
RIM3D = 1.00                            # inner lip: the liquid stops here
LIQ_SLOPE3D = 0.45                      # full tilt -> this much surface slope


def sdf3d(x, y, z, liq_y, pl=None):
    """Signed distance to the scene. Returns (distance, material 0/1/2).

    `pl` is the liquid surface plane (nx, ny, nz, c) from liquid_plane() when
    the machine is tilted, or None for a level surface (the cheap path).
    """
    q = math.sqrt(x * x + z * z)
    best = 1e9
    for ax, ay, dx, dy, dd in WALL_SEGS3D:
        px, py = q - ax, y - ay
        h = (px * dx + py * dy) / dd
        h = 0.0 if h < 0.0 else (1.0 if h > 1.0 else h)
        ex, ey = px - dx * h, py - dy * h
        d = ex * ex + ey * ey
        if d < best:
            best = d
    d_cup = math.sqrt(best) - 0.05
    hx, hy = x - 0.92, (y - 0.55) * 1.15            # handle torus
    qq = math.sqrt(hx * hx + hy * hy) - 0.30
    d_han = math.sqrt(qq * qq + z * z) - 0.055
    if d_han < d_cup:
        d_cup = d_han
    best = 1e9
    for ax, ay, dx, dy, dd in SAUCER_SEGS3D:
        px, py = q - ax, y - ay
        h = (px * dx + py * dy) / dd
        h = 0.0 if h < 0.0 else (1.0 if h > 1.0 else h)
        ex, ey = px - dx * h, py - dy * h
        d = ex * ex + ey * ey
        if d < best:
            best = d
    d_sau = math.sqrt(best) - 0.045
    if pl is None:
        d_liq = y - liq_y                            # liquid: capped disc
    else:
        # tilted: the coffee stays level with real gravity while the cup
        # leans with the laptop, capped at the rim so a hard lean brims
        # instead of floating out over the wall
        d_liq = x * pl[0] + y * pl[1] + z * pl[2] - pl[3]
        if y - RIM3D > d_liq:
            d_liq = y - RIM3D
    if q - LIQ_R3D > d_liq:
        d_liq = q - LIQ_R3D
    if 0.12 - y > d_liq:
        d_liq = 0.12 - y
    if d_liq < d_cup and d_liq < d_sau:
        return d_liq, 2
    if d_sau < d_cup:
        return d_sau, 1
    return d_cup, 0


def cam3d(yaw, pitch, roll=0.0):
    """Camera eye + orthonormal basis for the orbit camera."""
    tx, ty, tz = 0.0, 0.55, 0.0
    dist = 3.4
    cp, sp = math.cos(pitch), math.sin(pitch)
    ex, ey, ez = tx + dist * cp * math.sin(yaw), ty + dist * sp, tz + dist * cp * math.cos(yaw)
    fx, fy, fz = tx - ex, ty - ey, tz - ez
    fl = math.sqrt(fx * fx + fy * fy + fz * fz)
    fx, fy, fz = fx / fl, fy / fl, fz / fl
    rx, rz = -fz, fx
    rl = math.sqrt(rx * rx + rz * rz)
    rx, rz = rx / rl, rz / rl
    ux, uy, uz = -rz * fy, rz * fx - rx * fz, rx * fy
    cr, sr = math.cos(roll), math.sin(roll)
    rx, ry, rz, ux, uy, uz = (rx*cr + ux*sr, uy*sr, rz*cr + uz*sr,
                             ux*cr - rx*sr, uy*cr, uz*cr - rz*sr)
    return ex, ey, ez, fx, fy, fz, rx, ry, rz, ux, uy, uz


def cam_angles(scene):
    return (scene.yaw + scene.yaw_kick,
            max(0.10, min(0.98, scene.pitch + scene.pitch_kick)),
            scene.roll)


def liquid_plane(scene, liq_y):
    """The liquid surface under a tilted laptop, in cup space.

    The terminal is bolted to the laptop and so is everything drawn in it, so
    tilting the machine does not move the cup on screen — it moves *gravity*.
    The surface therefore stays level with the real world while the cup leans
    around it, which is what makes the coffee climb the near wall when you tip
    the screen toward you. Screen axes are resolved through the orbit camera,
    so the slant holds still on screen while the camera swings around it.

    Returns (nx, ny, nz, c, sx, sz): the plane n.p == c, plus the downhill
    slope the steam has to lean against. None when the machine is level.
    """
    tx, ty = scene.tilt_in
    if not tx and not ty:
        return None
    yaw = cam_angles(scene)[0]
    cy, sy = math.cos(yaw), math.sin(yaw)
    # screen right = (cy, -sy); screen "toward the viewer" = (sy, cy)
    sx = (tx * cy + ty * sy) * LIQ_SLOPE3D
    sz = (ty * cy - tx * sy) * LIQ_SLOPE3D
    inv = 1.0 / math.sqrt(1.0 + sx * sx + sz * sz)
    return (-sx * inv, inv, -sz * inv, liq_y * inv, sx, sz)


def project3d(scene, wx, wy, wz):
    """World point -> (col, half-block row) under the current orbit camera."""
    W, Hpx = scene.W, scene.H
    ex, ey, ez, fx, fy, fz, rx, ry, rz, ux, uy, uz = cam3d(*cam_angles(scene))
    wx, wy, wz = wx - ex, wy - ey, wz - ez
    zc = wx * fx + wy * fy + wz * fz
    uc = (wx * rx + wy * ry + wz * rz) / zc * 1.9
    vc = (wx * ux + wy * uy + wz * uz) / zc * 1.9
    aspect = W / Hpx
    return ((uc / (aspect * 0.95) + 1) / 2 * W,
            (1 - (vc + 0.28) / 0.95) / 2 * Hpx)


def render3d(scene):
    """Sphere-trace the scene into a px buffer (None = background)."""
    Wf, Hf = scene.W, scene.H
    half = Wf * Hf > (60000 if scene.S else 9000)
    W, Hpx = (Wf // 2, Hf // 2) if half else (Wf, Hf)
    th = scene._th
    cup_col, liq_col, crema, sauc_col = th["cup"], th["liquid"], th["crema"], th["saucer"]
    liq_y = 0.30 + 0.62 * scene.level
    pl = liquid_plane(scene, liq_y)
    ex, ey, ez, fx, fy, fz, rx, ry, rz, ux, uy, uz = cam3d(*cam_angles(scene))
    lx, ly, lz = -0.4082, 0.7715, -0.4876            # normalized key light
    ws = scene.water.sample
    aspect = W / Hpx
    px = [[None] * W for _ in range(Hpx)]
    zb = [[1e9] * W for _ in range(Hpx)]     # hit distances, for steam occlusion
    scene._zb = (zb, W, Hpx)
    ocy = ey - 0.45
    c_sph = ex * ex + ocy * ocy + ez * ez - 2.6244   # bounding sphere r=1.62
    sdf = sdf3d
    for j in range(Hpx):
        v = (1 - (j + 0.5) / Hpx * 2) * 0.95 - 0.28
        row = px[j]
        dyv = fy * 1.9 + uy * v
        for i in range(W):
            u = ((i + 0.5) / W * 2 - 1) * aspect * 0.95
            dx = fx * 1.9 + rx * u + ux * v
            dy = dyv + ry * u
            dz = fz * 1.9 + rz * u + uz * v
            dl = math.sqrt(dx * dx + dy * dy + dz * dz)
            dx, dy, dz = dx / dl, dy / dl, dz / dl
            b = ex * dx + ocy * dy + ez * dz
            disc = b * b - c_sph
            if disc < 0:
                continue
            sq = math.sqrt(disc)
            t1 = -b + sq
            if t1 < 0:
                continue
            t = max(-b - sq, 0.0)
            mat = -1
            for _ in range(48):
                pxx, pyy, pzz = ex + dx * t, ey + dy * t, ez + dz * t
                d, m = sdf(pxx, pyy, pzz, liq_y, pl)
                if d < 0.0035 + 0.0015 * t:
                    mat = m
                    break
                t += d * 0.92
                if t > t1:
                    break
            if mat < 0:
                continue
            zb[j][i] = t
            e = 0.004
            nx = sdf(pxx + e, pyy, pzz, liq_y, pl)[0] - sdf(pxx - e, pyy, pzz, liq_y, pl)[0]
            ny = sdf(pxx, pyy + e, pzz, liq_y, pl)[0] - sdf(pxx, pyy - e, pzz, liq_y, pl)[0]
            nz = sdf(pxx, pyy, pzz + e, liq_y, pl)[0] - sdf(pxx, pyy, pzz - e, liq_y, pl)[0]
            nl = math.sqrt(nx * nx + ny * ny + nz * nz) or 1.0
            nx, ny, nz = nx / nl, ny / nl, nz / nl
            if mat == 2:                              # bump-map from the water sim
                lu, lv = pxx / LIQ_R3D, pzz / LIQ_R3D
                gx = (ws(lu + 0.09, lv) - ws(lu - 0.09, lv)) * 1.4
                gz = (ws(lu, lv + 0.09) - ws(lu, lv - 0.09)) * 1.4
                nx -= gx
                nz -= gz
                nl = math.sqrt(nx * nx + ny * ny + nz * nz)
                nx, ny, nz = nx / nl, ny / nl, nz / nl
            diff = nx * lx + ny * ly + nz * lz
            spec_sh = 1.0
            if diff < 0:
                diff = 0.0
            elif diff > 0.02:                 # one soft shadow ray per hit
                sh = 1.0
                ts = 0.05
                ox, oy, oz = pxx + nx * 0.008, pyy + ny * 0.008, pzz + nz * 0.008
                for _ in range(20):
                    dsh = sdf(ox + lx * ts, oy + ly * ts, oz + lz * ts, liq_y, pl)[0]
                    if dsh < 0.0012:
                        sh = 0.0
                        break
                    pen = 10.0 * dsh / ts
                    if pen < sh:
                        sh = pen
                    ts += dsh if dsh > 0.02 else 0.02
                    if ts > 2.2 or sh < 0.05:
                        break
                sh = max(0.0, sh)
                diff *= 0.22 + 0.78 * sh
                spec_sh = 0.25 + 0.75 * sh
            hx_, hy_, hz_ = lx - dx, ly - dy, lz - dz
            hl = math.sqrt(hx_ * hx_ + hy_ * hy_ + hz_ * hz_) or 1.0
            spec = (nx * hx_ + ny * hy_ + nz * hz_) / hl
            spec = spec ** 40 * spec_sh if spec > 0 else 0.0
            fres = (1.0 - max(0.0, -(nx * dx + ny * dy + nz * dz))) ** 2
            if mat == 2:
                base = tuple(int(a + (b - a) * min(1.0, 0.18 + diff * 0.45 + spec * 0.6))
                             for a, b in zip(liq_col, crema))
                k = 0.38 + 0.7 * diff
                # one reflection bounce: the liquid mirrors the cup's inner
                # wall and rim light, weighted by fresnel
                nd = nx * dx + ny * dy + nz * dz
                rdx, rdy, rdz = dx - 2 * nd * nx, dy - 2 * nd * ny, dz - 2 * nd * nz
                tr = 0.02
                ox, oy, oz = pxx + nx * 0.012, pyy + ny * 0.012, pzz + nz * 0.012
                rpy = 0.0
                hitr = False
                for _ in range(16):
                    dr, mr = sdf(ox + rdx * tr, oy + rdy * tr, oz + rdz * tr, liq_y, pl)
                    if dr < 0.004:
                        hitr = mr != 2
                        rpy = oy + rdy * tr
                        break
                    tr += dr * 0.95
                    if tr > 2.0:
                        break
                if hitr:
                    rc = shade(cup_col, 0.30 + 0.55 * max(0.0, min(1.0, rpy)))
                    krf = 0.16 + 0.45 * fres
                    base = tuple(int(b + (c - b) * krf) for b, c in zip(base, rc))
            else:
                base = cup_col if mat == 0 else sauc_col
                if scene.theme_key == "diner":
                    stripe = abs(pyy - .862) < .018 if mat == 0 else abs(math.hypot(pxx, pzz) - 1.14) < .02
                    if stripe:
                        base = (112, 31, 37)
                k = 0.24 + 0.78 * diff
            row[i] = (min(255, int(base[0] * k + 200 * spec + 26 * fres)),
                      min(255, int(base[1] * k + 200 * spec + 26 * fres)),
                      min(255, int(base[2] * k + 200 * spec + 30 * fres)))
    if half:
        jm, im = Hpx - 1, W - 1
        return [[px[min(j // 2, jm)][min(i // 2, im)] for i in range(Wf)]
                for j in range(Hf)]
    return px


# --------------------------------------------------------------------------
# IMU: the hidden accelerometer/gyro in Apple Silicon MacBooks (M2+)
# --------------------------------------------------------------------------
# The SPU (Sensor Processing Unit) exposes a real MEMS IMU as AppleSPUHIDDevice
# HID services (credit: github.com/olvvier/apple-silicon-accelerometer for the
# report format). Opening the device needs root, so a small bridge process
# (`sudo caf-art --imu-bridge`) streams samples to IMU_PATH; the unprivileged
# renderer auto-detects fresh samples and turns real laptop motion into
# physics: tilt slants the coffee, shoves slosh it, the gyro spins the camera.

IMU_PATH = "/tmp/caf-imu.dat"
IMU_FMT = "<4sId8f"                   # magic, ver, t(f64), ax..gz, lux, checksum
IMU_MAGIC = b"CIMU"

# Orientation. The sensor is not chassis-aligned and the mounting is not
# documented: an M-series MacBook sitting flat on a desk reads a ~20 degree
# lean (a = (+0.05, -0.34, -0.92) g on the machine this was tuned on). Using
# raw gravity components as tilt therefore bakes in a permanent slant — enough
# to leave the coffee riding the spill threshold with nobody touching the
# laptop. Tilt is measured against a calibrated rest pose instead, and the
# horizontal axes are derived from it rather than picked by array index.
DEG = math.pi / 180.0
IMU_TAU = 0.45          # complementary filter: how fast accel corrects gyro
IMU_DEAD = 0.030        # ~1.7 deg deadband — sensor noise, not a lean
IMU_FULL = 0.38         # ~22 deg of lean = full-scale tilt
IMU_SNAP = 0.25         # first-second calibration time constant
IMU_LEVEL = 45.0        # optional --auto-level drift toward a new resting pose
IMU_SMOOTH = 0.11       # output low-pass (seconds)


def imu_axis_flips():
    """CAF_IMU_FLIP: which way is 'right' and 'away' on this chassis.

    The SPU publishes no axis convention, so the defaults below are the ones
    that came out right on the machines this was tested on. Any mix of 'x'
    (mirror left/right), 'y' (mirror near/far) and 's' (swap the two) fixes a
    machine that leans the wrong way; `caf-art --imu-tilt` shows live values.
    """
    f = os.getenv("CAF_IMU_FLIP", "").lower()
    return (-1.0 if "x" in f else 1.0, -1.0 if "y" in f else 1.0, "s" in f)


def tilt_curve(ang):
    """Lean angle (rad) -> sim tilt.

    A deadband first, so noise and a slowly drifting reference never move the
    coffee, then linear to full scale at IMU_FULL: the useful range is a wrist
    tilt of the screen, not a 30-degree heave of the whole machine.
    """
    m = abs(ang)
    if m < IMU_DEAD:
        return 0.0
    return math.copysign(min(1.0, (m - IMU_DEAD) / (IMU_FULL - IMU_DEAD)) * 0.95,
                         ang)


def imu_write_sample(fd, t, a, g, lux):
    chk = a[0] + a[1] + a[2] + g[0] + g[1] + g[2] + lux
    os.pwrite(fd, struct.pack(IMU_FMT, IMU_MAGIC, 2, t, a[0], a[1], a[2],
                              g[0], g[1], g[2], lux, chk), 0)


def imu_read_sample():
    """Returns (t, (ax, ay, az), (gx, gy, gz), lux) or None. lux < 0 = no ALS."""
    try:
        with open(IMU_PATH, "rb") as f:
            raw = f.read(struct.calcsize(IMU_FMT))
        magic, _ver, t, ax, ay, az, gx, gy, gz, lux, chk = struct.unpack(IMU_FMT, raw)
        if (magic != IMU_MAGIC or _ver != 2
                or not all(math.isfinite(v) for v in (t, ax, ay, az, gx, gy, gz, lux, chk))
                or abs((ax + ay + az + gx + gy + gz + lux) - chk) > 1e-2):
            return None
        return t, (ax, ay, az), (gx, gy, gz), lux
    except Exception:
        return None


def imu_start_bridge():
    """Start the sensor bridge unless one is already streaming (M2+ only; it
    exits harmlessly on machines without the sensor)."""
    if sys.platform != "darwin":
        return None
    s = imu_read_sample()
    if s and abs(time.monotonic() - s[0]) <= 0.6:
        return None
    try:
        return subprocess.Popen([os.path.abspath(__file__), "--imu-bridge",
                                 "--quiet"],
                                stdout=subprocess.DEVNULL,
                                stderr=subprocess.DEVNULL)
    except OSError:
        return None


def imu_bridge(debug_secs=0, quiet=False):
    """Bridge-side reader: IOKit HID -> IMU_PATH. Ctypes only, no dependencies."""
    s = imu_read_sample()
    if s and abs(time.monotonic() - s[0]) < 0.6 and not debug_secs:
        if not quiet:
            print("caf imu: a bridge is already streaming")
        return 0
    import ctypes
    import ctypes.util
    iokit = ctypes.cdll.LoadLibrary(ctypes.util.find_library("IOKit"))
    cf = ctypes.cdll.LoadLibrary(ctypes.util.find_library("CoreFoundation"))
    C = ctypes

    cf.CFStringCreateWithCString.restype = C.c_void_p
    cf.CFStringCreateWithCString.argtypes = [C.c_void_p, C.c_char_p, C.c_uint32]
    cf.CFNumberGetValue.argtypes = [C.c_void_p, C.c_long, C.c_void_p]
    cf.CFRunLoopGetCurrent.restype = C.c_void_p
    cf.CFRunLoopRunInMode.argtypes = [C.c_void_p, C.c_double, C.c_bool]
    cf.CFRunLoopRunInMode.restype = C.c_int32
    iokit.IOServiceMatching.restype = C.c_void_p
    iokit.IOServiceMatching.argtypes = [C.c_char_p]
    iokit.IOServiceGetMatchingServices.argtypes = [C.c_uint32, C.c_void_p,
                                                   C.POINTER(C.c_uint32)]
    iokit.IOIteratorNext.restype = C.c_uint32
    iokit.IOIteratorNext.argtypes = [C.c_uint32]
    iokit.IORegistryEntryCreateCFProperty.restype = C.c_void_p
    iokit.IORegistryEntryCreateCFProperty.argtypes = [C.c_uint32, C.c_void_p,
                                                      C.c_void_p, C.c_uint32]
    iokit.IOHIDDeviceCreate.restype = C.c_void_p
    iokit.IOHIDDeviceCreate.argtypes = [C.c_void_p, C.c_uint32]
    iokit.IOHIDDeviceOpen.argtypes = [C.c_void_p, C.c_uint32]
    iokit.IOHIDDeviceRegisterInputReportWithTimeStampCallback.argtypes = [
        C.c_void_p, C.POINTER(C.c_ubyte), C.c_long, C.c_void_p, C.c_void_p]
    iokit.IOHIDDeviceScheduleWithRunLoop.argtypes = [C.c_void_p, C.c_void_p,
                                                     C.c_void_p]
    iokit.IORegistryEntrySetCFProperty.argtypes = [C.c_uint32, C.c_void_p,
                                                   C.c_void_p]
    cf.CFNumberCreate.restype = C.c_void_p
    cf.CFNumberCreate.argtypes = [C.c_void_p, C.c_long, C.c_void_p]

    def cfstr(s):
        return cf.CFStringCreateWithCString(None, s.encode(), 0x08000100)

    def cfnum32(v):
        return cf.CFNumberCreate(None, 3, C.byref(C.c_int32(v)))

    def enable_streaming(svc):
        """Wake the sensor: reporting on, power on, 1ms report interval."""
        errs = 0
        for k, v in (("SensorPropertyReportingState", 1),
                     ("SensorPropertyPowerState", 1),
                     ("ReportInterval", 1000)):
            if iokit.IORegistryEntrySetCFProperty(svc, cfstr(k), cfnum32(v)) != 0:
                errs += 1
        return errs

    def num_prop(svc, key):
        ref = iokit.IORegistryEntryCreateCFProperty(svc, cfstr(key), None, 0)
        if not ref:
            return None
        out = C.c_int32(0)
        cf.CFNumberGetValue(ref, 3, C.byref(out))     # kCFNumberSInt32Type
        return out.value

    it = C.c_uint32(0)
    matching = iokit.IOServiceMatching(b"AppleSPUHIDDevice")
    if iokit.IOServiceGetMatchingServices(0, matching, C.byref(it)) != 0:
        if not quiet:
            print("caf imu: could not enumerate AppleSPUHIDDevice services")
        return 1
    targets = {}                       # kind -> io_service_t
    while True:
        svc = iokit.IOIteratorNext(it)
        if not svc:
            break
        up, u = num_prop(svc, "PrimaryUsagePage"), num_prop(svc, "PrimaryUsage")
        if (up, u) == (0xFF00, 3):
            targets.setdefault("accel", svc)
        elif (up, u) == (0xFF00, 9):
            targets.setdefault("gyro", svc)
        elif (up, u) == (0xFF00, 4):
            targets.setdefault("als", svc)
    if "accel" not in targets:
        if not quiet:
            print("caf imu: no SPU accelerometer found (needs an M2+ MacBook)")
        return 1
    prop_errs = sum(enable_streaming(svc) for svc in targets.values())
    # the enable knobs live on the AppleSPUHIDDriver services as well
    it2 = C.c_uint32(0)
    if iokit.IOServiceGetMatchingServices(
            0, iokit.IOServiceMatching(b"AppleSPUHIDDriver"), C.byref(it2)) == 0:
        while True:
            svc = iokit.IOIteratorNext(it2)
            if not svc:
                break
            up, u = num_prop(svc, "PrimaryUsagePage"), num_prop(svc, "PrimaryUsage")
            if (up, u) in ((0xFF00, 3), (0xFF00, 9), (0xFF00, 4)):
                prop_errs += enable_streaming(svc)
    if prop_errs and os.geteuid() != 0 and debug_secs:
        print(f"caf imu: {prop_errs} sensor-enable writes failed on the device "
              "layer (driver layer usually suffices; try sudo if no samples flow)")

    state = {"a": (0.0, 0.0, 0.0), "g": (0.0, 0.0, 0.0), "l": -1.0, "n": 0,
             "lraw": b"", "an": 0}
    CB = C.CFUNCTYPE(None, C.c_void_p, C.c_int32, C.c_void_p, C.c_uint32,
                     C.c_uint32, C.POINTER(C.c_ubyte), C.c_long, C.c_uint64)

    def make_cb(kind):
        if kind == "als":
            # 64-byte report: u32 counter, u16, u32 ts, zeros, 5x u32 raw
            # channel counts, then float32 lux at offset 40 (verified live)
            def cb(_ctx, _res, _sender, _type, _rid, report, length, _ts):
                if length < 44:
                    return
                data = bytes(report[:int(length)])
                state["lraw"] = data
                lux = struct.unpack_from("<f", data, 40)[0]
                if 0.0 <= lux < 200000.0:
                    state["l"] = lux
                state["n"] += 1
        else:
            key = kind[0]

            def cb(_ctx, _res, _sender, _type, _rid, report, length, _ts):
                if length < 18:
                    return
                data = bytes(report[:int(length)])
                x, y, z = struct.unpack_from("<iii", data, 6)
                state[key] = (x / 65536.0, y / 65536.0, z / 65536.0)
                if key == "a":
                    state["an"] += 1
                state["n"] += 1
        return CB(cb)

    refs = []                          # keep callbacks + buffers alive
    opened = 0
    for kind, svc in targets.items():
        dev = iokit.IOHIDDeviceCreate(None, svc)
        if not dev:
            continue
        kr = iokit.IOHIDDeviceOpen(dev, 0)
        if kr != 0:
            if not quiet:
                print(f"caf imu: open {kind} failed (0x{kr & 0xFFFFFFFF:08x})"
                      + ("" if os.geteuid() == 0 else " — run with sudo"))
            continue
        buf = (C.c_ubyte * 64)()
        cb = make_cb(kind)
        refs.append((buf, cb))
        iokit.IOHIDDeviceRegisterInputReportWithTimeStampCallback(dev, buf, 64, cb, None)
        iokit.IOHIDDeviceScheduleWithRunLoop(dev, cf.CFRunLoopGetCurrent(),
                                             C.c_void_p.in_dll(cf, "kCFRunLoopDefaultMode"))
        opened += 1
    if not opened:
        return 1

    fd = os.open(IMU_PATH, os.O_WRONLY | os.O_CREAT, 0o644)
    try:
        os.fchmod(fd, 0o644)
    except OSError:
        pass
    if not quiet:
        print(f"caf imu bridge: streaming {' + '.join(targets)} to {IMU_PATH}"
              + (f" (debug {debug_secs}s)" if debug_secs else " — Ctrl+C to stop"))
    t_end = time.monotonic() + debug_secs if debug_secs else None
    last_dbg = 0.0
    published = 0
    try:
        while t_end is None or time.monotonic() < t_end:
            cf.CFRunLoopRunInMode(
                C.c_void_p.in_dll(cf, "kCFRunLoopDefaultMode"), 0.008, False)
            now = time.monotonic()
            if state["an"] != published:
                imu_write_sample(fd, now, state["a"], state["g"], state["l"])
                published = state["an"]
            if debug_secs and now - last_dbg > 0.25:
                last_dbg = now
                a, g = state["a"], state["g"]
                als = (f"  lux={state['l']:8.2f} raw[{len(state['lraw'])}]="
                       f"{state['lraw'].hex()}" if state["lraw"] else "")
                print(f"n={state['n']:6d}  a=({a[0]:+.3f},{a[1]:+.3f},{a[2]:+.3f})g"
                      f"  gyro=({g[0]:+7.2f},{g[1]:+7.2f},{g[2]:+7.2f})dps" + als)
    except KeyboardInterrupt:
        pass
    finally:
        os.close(fd)
    return 0


