class Scene:
    def __init__(self, theme_key, hires_scale=0):
        self.theme_key = theme_key
        self.theme = THEMES[theme_key]
        self.S = hires_scale            # 0 = ANSI mode, >0 = px per cell width
        self.particles = []             # [x, y, phase, age, life] in layout coords
        self.sparkles = []
        self.precip = []                # [x, y, vx, vy] rain/snow
        self.t = 0.0
        self.level = 1.0
        self.target_level = 1.0
        self.sips = 0
        self.stir_t = -99.0
        self.wind = 0.0
        self.heat = 0.0
        self._heat_at = 0.0
        self.weather = None
        self.water = Water()
        self.word = None                # dict(pairs=[(particle, tx, ty)], until=t)
        self.mode3d = False
        self.yaw = 0.6
        self.pitch = 0.38
        self.auto_orbit = True
        self.z_push = 0.0               # 2.5D: >0 pushes steam toward the viewer
        self.updraft = 0.0
        self.yaw_kick = 0.0             # 3d camera parallax from window motion
        self.pitch_kick = 0.0

    # ---- events ----------------------------------------------------------

    def cycle_theme(self):
        keys = list(THEMES)
        self.theme_key = keys[(keys.index(self.theme_key) + 1) % len(keys)]
        self.theme = THEMES[self.theme_key]
        self.sparkles = []

    def sip(self, pomo=False):
        self.sips += 1
        self.water.disturb(0.0, 0.75, -0.55, 0.2)
        if not pomo:
            if self.target_level <= 0.3:
                self.target_level = 1.0
            else:
                self.target_level = max(0.18, self.target_level - 0.27)

    def stir(self):
        self.stir_t = self.t

    def gust(self, cols_delta):
        self.wind = max(-6.0, min(6.0, cols_delta * 0.4))

    def window_motion(self, vx, vy):
        """React to the terminal window being dragged (vx/vy in px/s).

        Horizontal drags blow the steam sideways; vertical drags read as
        toward/away motion: an updraft plus a 2.5D depth push that swells or
        shrinks the wisps. Hard shoves slosh the coffee by inertia and, in 3D,
        nudge the camera for parallax.
        """
        self.wind = max(-8.0, min(8.0, self.wind - vx * 0.006))
        self.updraft = max(-8.0, min(8.0, self.updraft + vy * 0.005))
        self.z_push = max(-1.5, min(1.5, self.z_push + vy * 0.0012))
        speed = math.hypot(vx, vy)
        if speed > 700:                              # inertial slosh
            su = -0.65 if vx > 0 else 0.65
            if abs(vy) > abs(vx):
                su = random.uniform(-0.3, 0.3)
            self.water.disturb(su, random.uniform(-0.4, 0.4),
                               min(0.5, speed / 4000), 0.16)
        if self.mode3d:
            self.yaw_kick = max(-0.3, min(0.3, self.yaw_kick - vx * 0.00012))
            self.pitch_kick = max(-0.2, min(0.2, self.pitch_kick + vy * 0.00010))

    def write_word(self, text):
        """Steam particles converge to spell `text` above the cup, then dissolve."""
        text = "".join(ch for ch in text.upper() if ch in FONT) or "?"
        avail = max(8, self.cup_top * 2 - 6)
        k = max(1, min(4, (self.cup_w * 2 - 4) // (len(text) * 4),
                       avail // 8))
        w_dots = len(text) * 4 * k - k
        x0 = self.cx * 2 - w_dots // 2
        y0 = max(2, int(self.cup_top * 2 * 0.42) - (5 * k) // 2)
        targets = []
        for ci, ch in enumerate(text):
            for ry, rowbits in enumerate(FONT[ch]):
                for rx, bit in enumerate(rowbits):
                    if bit == "1":
                        for sy in range(k):
                            for sx in range(k):
                                targets.append((x0 + (ci * 4 + rx) * k + sx,
                                                y0 + ry * k + sy))
        if len(targets) > 420:
            targets = random.sample(targets, 420)
        pool = sorted(self.particles, key=lambda p: p[3])       # youngest first
        pairs = []
        for i, (bx, by) in enumerate(targets):
            if i < len(pool):
                p = pool[i]
            else:
                p = [self.cx + random.gauss(0, self.cup_w * 0.2),
                     float(self.cup_top + self.rim_h // 2),
                     random.uniform(0, math.tau), 0.0, self.cup_top * 1.0, 0.0]
                self.particles.append(p)
            pairs.append((p, bx / 2, by / 2))
        self.word = dict(pairs=pairs, until=self.t + 3.2)

    # ---- layout ----------------------------------------------------------

    def layout(self, cols, rows):
        self.cols, self.rows = cols, rows
        self.W = cols
        self.H = (rows - 1) * 2
        cup_h = max(8, min(40 * max(1, self.S), int(self.H * 0.42)))
        cup_w = int(cup_h * 1.7)
        max_w = self.W - max(10, self.W // 6)
        if cup_w > max_w:
            cup_w = max_w
            cup_h = max(8, int(cup_w / 1.7))
        self.cup_w, self.cup_h = cup_w, cup_h
        self.saucer_h = max(3, cup_h // 8)
        self.cx = self.W // 2 - max(2, cup_w // 10)
        self.cup_bot = self.H - 2 - self.saucer_h
        self.cup_top = self.cup_bot - cup_h
        self.rim_h = max(3, cup_h // 5)
        self.steam_by = max(2, (self.cup_top + self.rim_h) * 2)
        if self.mode3d:
            self._anchor3d()

    def _anchor3d(self):
        """Derive the 2D steam/word anchors from the projected 3D rim."""
        ci, cj = project3d(self, 0.0, 1.0, 0.0)
        _, _, _, _, _, _, rx, rz, _, _, _ = cam3d(*cam_angles(self))
        ri, _ = project3d(self, 0.8 * rx, 1.0, 0.8 * rz)
        half_w = max(4.0, abs(ri - ci))
        self.cx = int(ci)
        self.cup_w = int(half_w * 2)
        self.cup_top = max(2, int(cj))
        self.rim_h = max(2, int(half_w * math.sin(self.pitch)))
        self.steam_by = max(2, (self.cup_top + self.rim_h) * 2)

    # ---- simulation ------------------------------------------------------

    def _sample_heat(self):
        try:
            self.heat = min(1.0, os.getloadavg()[0] / max(1, os.cpu_count() or 1))
        except OSError:
            self.heat = 0.3

    def step(self, dt):
        t = self.t
        if self.mode3d:
            if self.auto_orbit:
                self.yaw += dt * 0.10
            self._anchor3d()
        if t - self._heat_at > 1.0:
            self._heat_at = t
            self._sample_heat()
        pouring = self.target_level - self.level > 0.04
        self.level += (self.target_level - self.level) * min(1.0, dt * (1.2 if pouring else 2.5))
        self.wind *= math.exp(-dt * 1.2)
        decay = math.exp(-dt * 1.6)
        self.updraft *= decay
        self.z_push *= decay
        self.yaw_kick *= decay
        self.pitch_kick *= decay

        # --- water surface ---
        w = self.water
        w.step()
        if random.random() < 0.25 + self.heat * 0.5:            # thermal jitter
            w.disturb(random.uniform(-0.7, 0.7), random.uniform(-0.7, 0.7),
                      random.uniform(0.008, 0.02 + 0.08 * self.heat), 0.08)
        if self.heat > 0.45 and random.random() < (self.heat - 0.4) * 0.9:
            w.disturb(random.uniform(-0.5, 0.5), random.uniform(-0.5, 0.5), 0.3, 0.06)  # boil bubble
        stir_age = t - self.stir_t
        if 0 <= stir_age < 1.3:                                  # orbiting spoon
            ang = stir_age * 9.0
            w.disturb(math.cos(ang) * 0.55, math.sin(ang) * 0.55, 0.35, 0.1)
        if pouring:
            w.disturb(-0.15, -0.2, random.uniform(0.15, 0.4), 0.09)

        # --- steam particles ---
        heat_k = 0.5 + 0.9 * self.heat
        rate = max(2, int((self.cup_w // 5) * (0.25 + 0.75 * self.level) * heat_k))
        for _ in range(rate):
            if random.random() < 0.65:
                k = random.randrange(3)
                plume = self.cx + math.sin(t * 0.6 + k * 2.1) * self.cup_w * 0.24
                self.particles.append([plume + random.gauss(0, 1.2),
                                       float(self.cup_top + self.rim_h // 2),
                                       random.uniform(0, math.tau), 0.0,
                                       random.uniform(0.7, 1.05) * self.cup_top, 0.0])

        word_set = set()
        if self.word:
            if t > self.word["until"]:
                for p, _, _ in self.word["pairs"]:
                    p[3] = min(p[3], p[4] * 0.35)
                self.word = None
            else:
                ease = min(1.0, dt * 5)
                for p, tx, ty in self.word["pairs"]:
                    p[0] += (tx - p[0]) * ease
                    p[1] += (ty - p[1]) * ease
                    word_set.add(id(p))

        alive = []
        top = max(1, self.cup_top)
        speed = 1.0 + 0.5 * self.heat
        for p in self.particles:
            if id(p) in word_set:
                alive.append(p)
                continue
            s = 6 + 22 * max(0.0, 1 - p[1] / top)
            nx, ny = curl(p[0] * 0.08 / max(1, self.S), p[1] * 0.08 / max(1, self.S), )
            sc = max(1, self.S)
            p[0] += (nx * s * sc + math.sin(t * 0.5) * 1.2 * sc + self.wind * 6 * sc * 0.1) * dt * 2.2
            p[1] -= (13 + 7 * math.sin(p[2]) - ny * s * 0.6 + self.updraft * 5) * dt * 1.35 * sc * speed
            p[5] += (self.z_push - p[5]) * min(1.0, dt * 2.5)
            p[3] += dt * 22
            if p[3] < p[4] and p[1] > 1:
                alive.append(p)
        self.particles = alive

        # --- weather ---
        sc = max(1, self.S)
        if self.weather == "rain":
            for _ in range(max(1, self.W // 40)):
                if random.random() < 0.7:
                    self.precip.append([random.uniform(0, self.W), 0.0, 0.35 * sc, 26.0 * sc])
        elif self.weather == "snow":
            if random.random() < 0.5:
                self.precip.append([random.uniform(0, self.W), 0.0,
                                    random.uniform(-1, 1) * sc, 5.0 * sc])
        keep = []
        for q in self.precip:
            q[0] += (q[2] + (math.sin(t * 0.8 + q[1] * 0.3) * 0.8 * sc if self.weather == "snow" else 0)) * dt
            q[1] += q[3] * dt
            if q[1] * 2 < self.steam_by and 0 <= q[0] < self.W:
                keep.append(q)
        self.precip = keep

        if self.theme["sparkle"] and not self.S:
            if random.random() < 0.18:
                self.sparkles.append([random.randint(2, self.cols - 3),
                                      random.randint(1, max(2, self.cup_top // 2 - 1)), 0])
            self.sparkles = [[c, r, a + 1] for c, r, a in self.sparkles if a < 7]

    # ---- drawing ---------------------------------------------------------

    def draw(self):
        if self.mode3d:
            px = render3d(self)
            sgrid = [[0.0] * (self.W * 2) for _ in range(self.steam_by)] if not self.S else None
            if self.S:
                self._splat_hires(px)
            else:
                self._splat_braille(px, sgrid)
            return px, sgrid
        W, H = self.W, self.H
        px = [[None] * W for _ in range(H)]
        th = self.theme
        t = self.t
        cx, cup_w, cup_h = self.cx, self.cup_w, self.cup_h
        top, bot, rim_h = self.cup_top, self.cup_bot, self.rim_h
        hw0 = cup_w / 2

        # sun halo: a warm static glow behind the cup
        if self.weather == "sun":
            hcy = top + cup_h * 0.35
            rx, ry = cup_w * 0.95, cup_h * 1.15
            for y in range(max(0, int(hcy - ry)), min(H, int(hcy + ry) + 1)):
                for x in range(max(0, int(cx - rx)), min(W, int(cx + rx) + 1)):
                    d = ((x - cx) / rx) ** 2 + ((y - hcy) / ry) ** 2
                    if d < 1:
                        px[y][x] = mix(BG_COL, (120, 84, 30), (1 - d) * 0.5)

        # saucer
        s_w = cup_w * 1.5
        for j in range(self.saucer_h):
            tt = j / max(1, self.saucer_h - 1)
            hw = (s_w / 2) * math.sqrt(max(0.0, 1 - (tt * 0.85) ** 2))
            y = bot + j
            if y >= H:
                break
            for x in range(int(cx - hw), int(cx + hw) + 1):
                if 0 <= x < W:
                    k = 0.9 - 0.45 * tt + 0.25 * math.exp(-((x - cx + hw * 0.3) / (hw * 0.45 + 1)) ** 2)
                    px[y][x] = shade(th["saucer"], k)

        # cup body
        for j in range(rim_h // 2, cup_h + 1):
            tt = j / cup_h
            hw = hw0 * (1 - 0.16 * tt)
            if tt > 0.78:
                hw *= math.sqrt(max(0.0, 1 - ((tt - 0.78) / 0.24) ** 2))
            y = top + j
            if not (0 <= y < H) or hw < 1:
                continue
            for x in range(int(cx - hw), int(cx + hw) + 1):
                if 0 <= x < W:
                    u = max(-1.0, min(1.0, (x - cx) / (hw + 1e-6)))
                    k = 0.52 + 0.30 * (1 - abs(u)) ** 0.7
                    k += 0.34 * math.exp(-((u + 0.45) / 0.28) ** 2)
                    k -= 0.18 * max(0.0, u - 0.55)
                    k *= 1.0 - 0.22 * tt
                    px[y][x] = shade(th["cup"], k)

        # handle
        hr = max(3, int(cup_h * 0.30))
        hcx, hcy = cx + hw0 * 0.92, top + cup_h * 0.45
        thick = max(1.4, cup_h * 0.07)
        for y in range(int(hcy - hr - thick), int(hcy + hr + thick) + 1):
            for x in range(int(hcx), int(hcx + hr + thick) + 1):
                if not (0 <= x < W and 0 <= y < H):
                    continue
                d = math.hypot((x - hcx) * 0.78, y - hcy)
                if abs(d - hr) <= thick and x >= hcx + 1:
                    k = 0.55 + 0.3 * (1 - abs(d - hr) / thick)
                    if px[y][x] is None or self.weather == "sun":
                        px[y][x] = shade(th["cup"], k)

        # rim + liquid: the water sim provides height + slope lighting
        ls = 0.45 + 0.55 * self.level
        voff = (1 - self.level) * 0.30
        wsamp = self.water.sample
        for j in range(rim_h + 1):
            v = (j - rim_h / 2) / (rim_h / 2 + 1e-6)
            hw = hw0 * math.sqrt(max(0.0, 1 - v * v))
            y = top + j
            if not (0 <= y < H) or hw < 1:
                continue
            for x in range(int(cx - hw), int(cx + hw) + 1):
                if not (0 <= x < W):
                    continue
                u = (x - cx) / (hw + 1e-6)
                if abs(u) > 0.86 or j == 0:
                    px[y][x] = shade(th["cup"], 1.05 - 0.25 * abs(u))
                    continue
                lu = u / (0.86 * ls)
                lv = (v - voff) / max(0.35, ls)
                if lu * lu + lv * lv > 1.0:
                    px[y][x] = shade(th["cup"], 0.30 + 0.08 * v)
                    continue
                hgt = wsamp(lu, lv)
                slope = (wsamp(lu + 0.09, lv) - hgt) + (wsamp(lu, lv + 0.09) - hgt)
                bright = 0.16 + hgt * 1.5 + slope * 3.2
                col = mix(th["liquid"], th["crema"], max(0.0, min(0.85, bright)))
                d = math.hypot(lu * 2.2, lv * 1.4)
                if d > 1.15:
                    col = mix(col, th["crema"], 0.35)
                gl = math.exp(-((lu + 0.35) ** 2 + (lv + 0.3) ** 2) / 0.18)
                col = mix(col, (255, 255, 255), 0.10 * gl)
                px[y][x] = col

        # pour stream while refilling
        sc = th["steam"]
        if self.target_level - self.level > 0.04:
            stream_x = cx - cup_w * 0.07
            liq_col = th["liquid"]
            for y in range(0, top + rim_h // 2):
                wob = math.sin(t * 6 + y * 0.4) * 0.8
                for dx in (0, 1):
                    xi = int(stream_x + wob) + dx
                    if 0 <= xi < W:
                        px[y][xi] = mix(liq_col, sc, 0.25)

        # steam + precip
        sgrid = [[0.0] * (W * 2) for _ in range(self.steam_by)] if not self.S else None
        if self.S:
            self._splat_hires(px)
        else:
            self._splat_braille(px, sgrid)
        return px, sgrid

    def _splat_braille(self, px, sgrid):
        W, H = self.W, self.H
        sc = self.theme["steam"]
        bw = W * 2
        for p in self.particles:
            x, y, age, life, pz = p[0], p[1], p[3], p[4], p[5]
            zk = 1.0 + pz * 0.55
            a = max(0.0, 1 - age / life) ** 1.3 * 0.95
            a = min(1.0, a * (1.0 + pz * 0.35))
            spread = max(1, int((1 + (1 - a) * 2) * zk))
            bx, by = int(x * 2), int(y * 2)
            for dx, dy, w in ((0, 0, 1.0), (-1, 0, 0.55), (1, 0, 0.55),
                              (0, -1, 0.5), (0, 1, 0.35),
                              (-1, -1, 0.3), (1, -1, 0.3), (-1, 1, 0.22), (1, 1, 0.22),
                              (-2, 0, 0.15), (2, 0, 0.15)):
                xi, yi = bx + dx * spread, by + dy
                if 0 <= xi < bw and 0 <= yi < self.steam_by:
                    sgrid[yi][xi] += a * w
            pyi, pxi = int(y), int(x)
            if 0 <= pxi < W and 0 <= pyi < H and px[pyi][pxi] is not None:
                px[pyi][pxi] = mix(px[pyi][pxi], sc, min(1.0, a * 0.55))
        for qx, qy, _, vy in self.precip:
            bx, by = int(qx * 2), int(qy * 2)
            if 0 <= bx < bw and 0 <= by < self.steam_by:
                sgrid[by][bx] += 0.5
                if self.weather == "rain" and by + 1 < self.steam_by:
                    sgrid[by + 1][bx] += 0.3

    def _splat_hires(self, px):
        W, H = self.W, self.H
        S = self.S
        sc = self.theme["steam"]
        for p in self.particles:
            x, y, age, life, pz = p[0], p[1], p[3], p[4], p[5]
            a = max(0.0, 1 - age / life) ** 1.3 * 0.95
            a = min(1.0, a * (1.0 + pz * 0.35))
            R = max(1, int((S * 0.5 + (1 - a) * S * 0.9) * (1.0 + pz * 0.55)))
            xi0, yi0 = int(x), int(y)
            for dy in range(-R, R + 1):
                yi = yi0 + dy
                if not (0 <= yi < H):
                    continue
                row = px[yi]
                for dx in range(-R, R + 1):
                    d2 = dx * dx + dy * dy
                    if d2 > R * R:
                        continue
                    xi = xi0 + dx
                    if not (0 <= xi < W):
                        continue
                    w = a * (1 - 0.7 * math.sqrt(d2) / R) * 0.55
                    base = row[xi] if row[xi] is not None else BG_COL
                    row[xi] = mix(base, sc, min(1.0, w))
        pc = (150, 170, 220) if self.weather == "rain" else (235, 235, 240)
        for qx, qy, _, _ in self.precip:
            xi, yi = int(qx), int(qy)
            if 0 <= xi < W and 0 <= yi < H and px[yi][xi] is None:
                px[yi][xi] = pc

    # ---- blit: buffers -> terminal lines (ANSI mode) ---------------------

    def blit(self, px, sgrid):
        out = []
        sc = self.theme["steam"]
        steam_cell_rows = self.steam_by // 4 + 1
        for row in range(self.rows - 1):
            top, bot = px[2 * row], px[2 * row + 1]
            line = []
            last_fg = object(); last_bg = object()
            for x in range(self.W):
                a, b = top[x], bot[x]
                if a is None and b is None:
                    if row < steam_cell_rows:
                        bits = 0
                        total = 0.0
                        lit = 0
                        for dx in (0, 1):
                            gx = x * 2 + dx
                            for dy in range(4):
                                gy = row * 4 + dy
                                if gy < self.steam_by:
                                    val = sgrid[gy][gx]
                                    if val > 0.12:
                                        bits |= BRAILLE_BIT[dx][dy]
                                        total += val
                                        lit += 1
                        if bits:
                            col = mix((0, 0, 0), sc, min(1.0, (total / lit) * 1.25))
                            if col != last_fg:
                                line.append(fg(col)); last_fg = col
                            if last_bg is not None:
                                line.append("\x1b[49m"); last_bg = None
                            line.append(chr(0x2800 | bits))
                            continue
                    if last_fg is not None or last_bg is not None:
                        line.append("\x1b[0m")
                        last_fg = last_bg = None
                    line.append(" ")
                elif a is not None and b is not None:
                    if a != last_fg:
                        line.append(fg(a)); last_fg = a
                    if b != last_bg:
                        line.append(bg(b)); last_bg = b
                    line.append("▀")
                elif a is not None:
                    if last_bg is not None:
                        line.append("\x1b[49m"); last_bg = None
                    if a != last_fg:
                        line.append(fg(a)); last_fg = a
                    line.append("▀")
                else:
                    if last_bg is not None:
                        line.append("\x1b[49m"); last_bg = None
                    if b != last_fg:
                        line.append(fg(b)); last_fg = b
                    line.append("▄")
            line.append("\x1b[0m\x1b[K")
            out.append("".join(line))

        overlay = []
        for c, r, age in self.sparkles:
            if 0 <= r < len(out):
                ch = "✦" if age < 4 else "·"
                overlay.append(f"\x1b[{r + 1};{c + 1}H{fg(self.theme['sparkle'])}{ch}\x1b[0m")
        return out, "".join(overlay)

    def status(self, elapsed, interactive, extra="", zen=False, width=None):
        if zen:
            return ""
        width = width or self.cols
        th = self.theme
        m, s = divmod(int(elapsed), 60)
        h, m = divmod(m, 60)
        clock = f"{h}:{m:02d}:{s:02d}" if h else f"{m:02d}:{s:02d}"
        n = round(self.level * 4)
        cup_bar = "▇" * n + "░" * (4 - n)
        hn = min(3, int(self.heat * 3 + 0.5))
        heat_bar = "▂▄▆"[:hn] or "·"
        if not interactive:
            keys = " · Ctrl+C to stop"
        elif self.mode3d:
            keys = " · [s]ip [␣]stir [←→↑↓/o]rbit [w]rite [t]heme [q]uit"
        else:
            keys = " · [s]ip [␣]stir [w]rite [t]heme [q]uit"
        text = f" {th['icon']}  {th['name']} · awake {clock} · cup {cup_bar} · heat {heat_bar}{extra}{keys} "
        if len(text) > width:
            text = f" {th['icon']} {clock} {cup_bar}{extra} "
        pad = max(0, (width - len(text)) // 2)
        return " " * pad + f"\x1b[2m{text}\x1b[0m"


