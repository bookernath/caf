# Sound (--sound): tiny procedurally generated WAVs played through afplay
# --------------------------------------------------------------------------

SND_RATE = 22050


class SoundKit:
    """Synthesizes a handful of foley WAVs once, plays them via afplay."""

    def __init__(self):
        self.dir = os.path.expanduser("~/.cache/caf/sounds")
        self.ok = sys.platform == "darwin" and shutil.which("afplay") is not None
        self._last = {}
        self._voices = []
        if self.ok:
            try:
                os.makedirs(self.dir, exist_ok=True)
                self._generate()
            except OSError:
                self.ok = False

    def play(self, name, vol=0.5):
        if not self.ok:
            return
        self._voices = [p for p in self._voices if p.poll() is None]
        if len(self._voices) >= 3:
            return
        now = time.monotonic()
        if now - self._last.get(name, 0.0) < 0.18:
            return
        self._last[name] = now
        path = os.path.join(self.dir, name + ".wav")
        if os.path.exists(path):
            try:
                self._voices.append(subprocess.Popen(["afplay", "-v", f"{vol:.2f}", path],
                                 stdout=subprocess.DEVNULL,
                                 stderr=subprocess.DEVNULL))
            except OSError:
                self.ok = False

    def close(self):
        for proc in self._voices:
            if proc.poll() is None:
                proc.terminate()
            try:
                proc.wait(timeout=.5)
            except subprocess.TimeoutExpired:
                proc.kill(); proc.wait()
        self._voices.clear()

    def _write(self, name, samples):
        import wave
        path = os.path.join(self.dir, name + ".wav")
        if os.path.exists(path):
            return
        with wave.open(path, "wb") as w:
            w.setnchannels(1)
            w.setsampwidth(2)
            w.setframerate(SND_RATE)
            w.writeframes(b"".join(
                struct.pack("<h", max(-32767, min(32767, int(s * 32767))))
                for s in samples))

    def _generate(self):
        R = SND_RATE
        rnd = random.Random(7)

        # clink: struck ceramic — a few bright partials, fast decay
        n = int(R * 0.22)
        self._write("clink", [
            sum(A * math.sin(2 * math.pi * f * i / R) * math.exp(-i / (R * d))
                for f, A, d in ((2350, 0.5, 0.03), (3170, 0.35, 0.022),
                                (5230, 0.2, 0.014)))
            * min(1.0, i / (R * 0.002)) for i in range(n)])

        # Impact-driven body foley: a lower ceramic knock, not breaking glass.
        n = int(R * .30)
        self._write("ceramic", [sum(a*math.sin(2*math.pi*f*i/R)*math.exp(-i/(R*d))
            for f,a,d in ((730,.45,.06),(1470,.3,.045),(2430,.18,.025)))
            for i in range(n)])
        # Broadband water splat with small resonant drops; only actual contacts
        # trigger this clip. Playback has a shared three-voice upper bound.
        n = int(R*.32)
        out = []; low = 0.
        for i in range(n):
            low += (rnd.uniform(-1,1)-low)*.32
            envelope = (1-math.exp(-i/(R*.003)))*math.exp(-i/(R*.075))
            drops = math.sin(2*math.pi*(480+900*i/n)*i/R)*.15
            out.append((low*.75+drops)*envelope)
        self._write("splash", out)

        # drip: a short blip sliding up in pitch
        n = int(R * 0.12)
        self._write("drip", [
            0.5 * math.sin(2 * math.pi * (900 + 700 * (i / n) ** 2) * i / R)
            * math.exp(-i / (R * 0.04)) for i in range(n)])

        # glug: three descending bubbles
        out = []
        for b in range(3):
            f0 = 320 - b * 60
            n = int(R * 0.14)
            for i in range(n):
                f = f0 * (1 - 0.4 * i / n)
                out.append(0.55 * math.sin(2 * math.pi * f * i / R)
                           * math.sin(math.pi * i / n))
            out.extend([0.0] * int(R * 0.03))
        self._write("glug", out)

        # slurp: filtered noise swelling with a little flutter
        n = int(R * 0.4)
        lp = 0.0
        out = []
        for i in range(n):
            lp += (rnd.uniform(-1, 1) - lp) * 0.18
            a = math.sin(math.pi * min(1.0, i / (n * 0.85))) ** 1.5
            out.append(lp * a * 0.9 * (1 + 0.3 * math.sin(2 * math.pi * 11 * i / R)))
        self._write("slurp", out)

        # chime: soft bell for the pomodoro
        n = int(R * 1.1)
        self._write("chime", [
            (0.4 * math.sin(2 * math.pi * 880 * i / R)
             + 0.25 * math.sin(2 * math.pi * 1318.5 * i / R))
            * math.exp(-i / (R * 0.35)) for i in range(n)])

        # crash: the cup meets the floor — noise burst + ringing shards
        n = int(R * 0.55)
        lp = 0.0
        out = []
        for i in range(n):
            lp += (rnd.uniform(-1, 1) - lp) * 0.6
            ring = (0.3 * math.sin(2 * math.pi * 1830 * i / R) * math.exp(-i / (R * 0.08))
                    + 0.22 * math.sin(2 * math.pi * 2710 * i / R) * math.exp(-i / (R * 0.05)))
            out.append(lp * 0.8 * math.exp(-i / (R * 0.06)) + ring)
        self._write("crash", out)


def tilt_bar(v, w=10):
    cells = ["\u00b7"] * (2 * w + 1)
    cells[w] = "|"
    n = max(-w, min(w, int(round(v * w))))
    for i in range(min(0, n), max(0, n) + 1):
        cells[w + i] = "\u2588"
    return "".join(cells)


def imu_tilt_debug(secs=30):
    """Live tilt readout — the tool for checking CAF_IMU_FLIP.

    Tilt the laptop and watch: `right` should fill rightwards as the right
    side of the machine goes down, `away` as the far edge goes down. If either
    runs backwards, or the two are crossed, set CAF_IMU_FLIP.
    """
    proc = imu_start_bridge()
    scene = Scene("classic")
    flip = os.getenv("CAF_IMU_FLIP", "") or "none"
    print("caf imu: tilt the laptop \u2014 right side down fills 'right', far "
          "edge down fills 'away'.")
    print(f"         crossed or backwards? set CAF_IMU_FLIP to any of x y s "
          f"(now: {flip}).  Ctrl+C to stop.")
    t_end = time.monotonic() + secs
    prev = None
    live = True
    try:
        while time.monotonic() < t_end:
            now = time.monotonic()
            smp = imu_read_sample()
            if not smp or abs(now - smp[0]) > 0.6:
                if live:
                    live = False
                    sys.stdout.write("\rwaiting for the sensor bridge\u2026"
                                     + " " * 40)
                    sys.stdout.flush()
                time.sleep(0.2)
                continue
            live = True
            if smp[0] != prev:
                scene.imu_input(smp[1], smp[2], smp[0] - (prev or smp[0] - 0.06))
                prev = smp[0]
            tx, ty = scene.tilt_in
            a = smp[1]
            sys.stdout.write(f"\r right {tilt_bar(tx)}  away {tilt_bar(ty)}"
                             f"   raw a=({a[0]:+.2f},{a[1]:+.2f},{a[2]:+.2f})g ")
            sys.stdout.flush()
            time.sleep(0.05)
    except KeyboardInterrupt:
        pass
    finally:
        if proc:
            proc.terminate()
    print()
    return 0


# --------------------------------------------------------------------------
# Shallow-water surface simulation
# --------------------------------------------------------------------------

WGW, WGH = 54, 26


class Water:
    """Height-field wave sim on an elliptical grid; walls reflect."""

    def __init__(self):
        self.h = [[0.0] * WGW for _ in range(WGH)]
        self.v = [[0.0] * WGW for _ in range(WGH)]
        self.tilt = (0.0, 0.0)          # equilibrium slope (real-world gravity)
        self.mask = [[False] * WGW for _ in range(WGH)]
        for gy in range(WGH):
            for gx in range(WGW):
                u = gx / (WGW - 1) * 2 - 1
                w = gy / (WGH - 1) * 2 - 1
                self.mask[gy][gx] = u * u + w * w <= 1.0

    def step(self):
        h, v, mask = self.h, self.v, self.mask
        for gy in range(WGH):
            hrow, vrow, mrow = h[gy], v[gy], mask[gy]
            up = h[gy - 1] if gy > 0 else hrow
            dn = h[gy + 1] if gy < WGH - 1 else hrow
            for gx in range(WGW):
                if not mrow[gx]:
                    continue
                c = hrow[gx]
                # out-of-mask neighbors mirror the cell -> reflecting wall
                left = hrow[gx - 1] if gx > 0 and mrow[gx - 1] else c
                right = hrow[gx + 1] if gx < WGW - 1 and mrow[gx + 1] else c
                above = up[gx] if mask[gy - 1][gx] and gy > 0 else c
                below = dn[gx] if gy < WGH - 1 and mask[gy + 1][gx] else c
                force = (left + right + above + below) / 4 - c
                tx, ty = self.tilt
                if tx or ty:
                    force += ((gx / (WGW - 1) * 2 - 1) * tx
                              + (gy / (WGH - 1) * 2 - 1) * ty - c) * 0.05
                vrow[gx] = (vrow[gx] + force * 0.55) * 0.985
        for gy in range(WGH):
            hrow, vrow, mrow = h[gy], v[gy], mask[gy]
            for gx in range(WGW):
                if mrow[gx]:
                    hrow[gx] = (hrow[gx] + vrow[gx]) * 0.999

    def disturb(self, u, w, amp, rad=0.14):
        cx = (u + 1) / 2 * (WGW - 1)
        cy = (w + 1) / 2 * (WGH - 1)
        r = max(1, int(rad * WGW))
        for gy in range(max(0, int(cy) - r), min(WGH, int(cy) + r + 1)):
            for gx in range(max(0, int(cx) - r), min(WGW, int(cx) + r + 1)):
                if self.mask[gy][gx]:
                    d2 = ((gx - cx) / r) ** 2 + ((gy - cy) / r) ** 2
                    if d2 < 1:
                        self.h[gy][gx] += amp * math.exp(-d2 * 3)

    def sample(self, u, w):
        gx = min(WGW - 1.001, max(0.0, (u + 1) / 2 * (WGW - 1)))
        gy = min(WGH - 1.001, max(0.0, (w + 1) / 2 * (WGH - 1)))
        ix, iy = int(gx), int(gy)
        fx, fy = gx - ix, gy - iy
        h = self.h
        a = h[iy][ix] + (h[iy][ix + 1] - h[iy][ix]) * fx
        b = h[iy + 1][ix] + (h[iy + 1][ix + 1] - h[iy + 1][ix]) * fx
        return a + (b - a) * fy


