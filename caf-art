def encode_png(w, h, rows):
    """rows: list of bytes objects, each 3*w RGB bytes."""
    def chunk(tag, data):
        c = tag + data
        return struct.pack(">I", len(data)) + c + struct.pack(">I", zlib.crc32(c))
    raw = b"".join(b"\x00" + r for r in rows)
    return (b"\x89PNG\r\n\x1a\n"
            + chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0))
            + chunk(b"IDAT", zlib.compress(raw, 6))
            + chunk(b"IEND", b""))


def kitty_emit(png, cols, rows_cells):
    b64 = base64.standard_b64encode(png).decode()
    parts = ["\x1b[H"]
    step = 4096
    for i in range(0, len(b64), step):
        last = i + step >= len(b64)
        ctl = f"m={0 if last else 1}"
        if i == 0:
            ctl = f"a=T,f=100,i=99,p=1,q=2,c={cols},r={rows_cells}," + ctl
        parts.append(f"\x1b_G{ctl};{b64[i:i + step]}\x1b\\")
    return "".join(parts)


def px_to_png(px, W, H):
    bgb = bytes(BG_COL)
    rows = []
    for y in range(H):
        row = bytearray()
        for c in px[y]:
            row += bytes(c) if c is not None else bgb
        rows.append(bytes(row))
    return encode_png(W, H, rows)


