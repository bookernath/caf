class Scene:
    def __init__(self, theme_key, hires_scale=0):
        self.theme_key = theme_key
        self.theme = THEMES[theme_key]
        self.S = hires_scale            # 0 = ANSI mode, >0 = px per cell width
        self.particles = []             # [x, y, phase, age, life] in layout coords
        self.sparkles = []
        self.precip = []                # [x, y, vx, vy] rain/snow
        self.t = 0.0
        self.real_fluid = False
        self.cup_motion = True
        self.cinematic = True
        self._physics_audio = {}
        self.fluid_events = []
        self.fluid_stats = {}
        self.gravity = (0., -1., 0.)
        self.fluid_accel = (0., 0., 0.)
        self.level = 1.0
        self.target_level = 1.0
        self.sips = 0
        self.stir_t = -99.0
        self.wind = 0.0
        self.heat = 0.0
        self._heat_at = 0.0
        self.weather = None
        self.water = Water()
        self.word = None                # dict(pairs=[(particle, tx, ty)], until=t)
        self.mode3d = False
        self.yaw = 0.6
        self.pitch = 0.48
        self.auto_orbit = False       # quiet diorama; o enables the old orbit
        self.z_push = 0.0               # 2.5D: >0 pushes steam toward the viewer
        self.updraft = 0.0
        self._imu_up = None             # filtered up vector (sensor frame)
        self._imu_rest = None           # calibrated level reference
        self._imu_basis = None          # (right, away, up) unit vectors
        self._imu_age = 0.0
        self._imu_still = 0.0
        self._imu_flip = imu_axis_flips()
        self._gyro_sign = 1.0           # learned handedness of the gyro
        self._gyro_score = 0.0
        self._imu_prev_a = None
        self.yaw_kick = 0.0             # 3d camera parallax from window motion
        self.roll = 0.0
        self.auto_level = False
        self._calibration = load_calibration()
        self._water_clock = 0.0
        self.pitch_kick = 0.0
        self.tilt_in = (0.0, 0.0)       # raw IMU tilt (cup rotation adds to it)
        # --- cup rigid body: the cup can rock, spill, slide, and fall ---
        self.cup_ang = 0.0              # lean angle (rad), + = leaning right
        self.cup_av = 0.0
        self.cup_dx = 0.0               # offset from the layout seat, in px
        self.cup_dy = 0.0
        self.cup_vx = 0.0
        self.cup_vy = 0.0
        self.cup_state = "seated"       # seated | airborne | floor | fallen
        self.reset_at = None            # scene time to restore order
        self.spills = 0
        self.drops = []                 # spilled coffee droplets [x, y, vx, vy]
        self.puddle = []                # per-column liquid depth on the floor
        self.stains = {}                # saucer column -> stain intensity
        self.snd = None                 # SoundKit.play when --sound
        self.ambient = 1.0              # ALS-driven scene brightness
        self._th = self.theme           # possibly dimmed copy used for drawing
        self.flat = []                  # 3d mode: screen-space word particles
        self._zb = None                 # 3d depth buffer (zb, W, Hpx)

    # ---- events ----------------------------------------------------------

    def cycle_theme(self):
        keys = list(THEMES)
        self.theme_key = keys[(keys.index(self.theme_key) + 1) % len(keys)]
        self.theme = THEMES[self.theme_key]
        self.sparkles = []

    def sip(self, pomo=False):
        self.sips += 1
        self.water.disturb(0.0, 0.75, -0.55, 0.2)
        if self.snd:
            self.snd("slurp", 0.5)
        if self.real_fluid:
            self.fluid_events.append({"kind": "refill" if self.level <= .3 and not pomo else "sip"})
        elif not pomo:
            if self.target_level <= 0.3:
                self.target_level = 1.0
            else:
                self.target_level = max(0.18, self.target_level - 0.27)

    def refill(self):
        if self.real_fluid:
            self.fluid_events.append({"kind": "refill"})
        else:
            self.target_level = 1.0

    def add_cream(self):
        if self.real_fluid:
            self.fluid_events.append({"kind": "cream"})

    def knock_over(self):
        if self.real_fluid and self.cup_motion:
            self.fluid_events.append({"kind": "knock"})
        elif not self.mode3d:
            self.nudge(2.0)

    def fluid_feedback(self, stats):
        """Foley follows measured contact events, never random timers."""
        if not self.snd:
            return
        now = stats.get("simulated_time", 0.)
        if any(t > now for t in self._physics_audio.values()):
            self._physics_audio.clear()  # explicit scene reset
        impact = stats.get("cup_impact", 0.)
        splash = stats.get("splash_impact", 0.)
        for name, strength, threshold, cooldown in (("ceramic", impact, .3, .24),
                                                     ("splash", splash, 12., .38)):
            if strength > threshold and now-self._physics_audio.get(name, -99.) >= cooldown:
                volume = min(.65, .1+math.sqrt(strength)*(.16 if name=="ceramic" else .006))
                self.snd(name, volume)
                self._physics_audio[name] = now

    def reset_fluid(self):
        if self.real_fluid:
            self.fluid_events = [{"kind": "reset"}]
        else:
            self.target_level = 1.0

    def stir(self):
        self.stir_t = self.t
        if self.snd:
            self.snd("clink", 0.4)

    def gust(self, cols_delta):
        self.wind = max(-6.0, min(6.0, cols_delta * 0.4))

    def nudge(self, k=1.0):
        """Physically poke the cup (x key / hard window shoves)."""
        if self.mode3d:
            if self.real_fluid:
                self.fluid_events.append({"kind": "poke"})
            # APIC receives a physical cup impulse; the legacy renderer
            # retains its original wave-only poke.
            self.water.disturb(random.uniform(-0.7, 0.7),
                               random.uniform(-0.7, 0.7), 0.45 * k, 0.2)
            if self.snd and not self.real_fluid:
                self.snd("clink", 0.35)
            return
        kick = random.uniform(1.6, 2.6) * k * random.choice((-1.0, 1.0))
        self.cup_av += kick
        self.water.disturb(-math.copysign(0.6, kick), 0.0, 0.4, 0.14)
        if self.snd:
            self.snd("clink", 0.35)

    def ambient_light(self, lux, dt):
        """ALS lux -> scene brightness (log response, dim room = embers)."""
        target = max(0.30, min(1.0, 0.30 + 0.70 * math.log10(1 + lux) / 2.0))
        self.ambient += (target - self.ambient) * min(1.0, dt * 1.5)

    def imu_level(self):
        """Re-zero the tilt: whatever pose the laptop is in now reads level."""
        self.gravity = (0., -1., 0.)
        self.fluid_accel = (0., 0., 0.)
        if self._imu_up is not None:
            self._imu_rest = list(self._imu_up)
            self._imu_age = 0.0
            self._imu_still = 0.0
            self.tilt_in = (0.0, 0.0)
            self.roll = 0.0

    def resume_imu(self, acceleration):
        """Reacquire orientation after idle without changing calibrated level."""
        mag = math.sqrt(sum(v*v for v in acceleration))
        if .85 < mag < 1.15 and self._imu_up is not None:
            self._imu_up = [v/mag for v in acceleration]
        self._imu_prev_a = None
        self.fluid_accel = (0., 0., 0.)

    def _imu_orient(self, a, g, dt):
        """Track which way is up, in sensor axes, and what 'level' means.

        A complementary filter: the gyro turns the up vector every sample
        (fast, but it drifts) and the accelerometer pulls it back over
        IMU_TAU (slow, but absolute). The plain accel low-pass this replaced
        had to choose between lagging the laptop by half a second and
        mistaking a shove for a tilt — this does neither, which is the whole
        difference between the coffee following the screen and the coffee
        catching up with it.

        Returns the (right, near, up) basis, or None until it has a fix.
        """
        self._imu_age += dt
        mag = math.sqrt(a[0] * a[0] + a[1] * a[1] + a[2] * a[2])
        if mag < 0.25:                  # free fall, or a sensor hiccup
            return self._imu_basis
        an = [c / mag for c in a]       # an points *up*: at rest an
                                        # accelerometer reads the reaction
                                        # force, not gravity
        if self._imu_up is None:
            self._imu_up = list(an)
            self._imu_rest = list(an)
        up = self._imu_up
        wx, wy, wz = (v * DEG * self._gyro_sign for v in g)
        x0, y0, z0 = up
        # a world-fixed vector turns the other way in the body frame: -w x up
        px = x0 - (wy * z0 - wz * y0) * dt
        py = y0 - (wz * x0 - wx * z0) * dt
        pz = z0 - (wx * y0 - wy * x0) * dt
        # the gyro's handedness is undocumented, so learn it: whichever sign
        # predicts the motion the accelerometer then measures is the right one
        pa = self._imu_prev_a
        if pa is not None and abs(mag - 1.0) < 0.15 and abs(wx) + abs(wy) + abs(wz) > 0.25:
            self._gyro_score += ((px - x0) * (an[0] - pa[0])
                                 + (py - y0) * (an[1] - pa[1])
                                 + (pz - z0) * (an[2] - pa[2]))
            if self._gyro_score < -0.02:
                self._gyro_sign = -self._gyro_sign
                self._gyro_score = 0.0
            elif self._gyro_score > 0.02:
                self._gyro_score = 0.02
        self._imu_prev_a = an
        # accel correction, faded out while the reading is not ~1g: a shove
        # is not gravity, and letting one masquerade as gravity is what makes
        # a sloshed cup slowly tip over
        k = min(1.0, dt / IMU_TAU) * max(0.0, 1.0 - abs(mag - 1.0) * 3.0)
        up[0] = px + (an[0] - px) * k
        up[1] = py + (an[1] - py) * k
        up[2] = pz + (an[2] - pz) * k
        n = math.sqrt(up[0] ** 2 + up[1] ** 2 + up[2] ** 2) or 1.0
        up[0] /= n
        up[1] /= n
        up[2] /= n
        # Settle the reference for the first second, then lock it: a held
        # side tilt must not disappear. --auto-level restores the old slow
        # drift toward a new resting pose; z explicitly resets either mode.
        rest = self._imu_rest
        still = abs(mag - 1.0) < 0.04 and abs(wx) + abs(wy) + abs(wz) < 0.5
        self._imu_still = max(0.0, self._imu_still + (dt if still else -dt * 4))
        young = self._imu_age < 1.2
        if young or (self.auto_level and self._imu_still > 3.0):
            kr = min(1.0, dt / (IMU_SNAP if young else IMU_LEVEL))
            for i in range(3):
                rest[i] += (up[i] - rest[i]) * kr
            n = math.sqrt(rest[0] ** 2 + rest[1] ** 2 + rest[2] ** 2) or 1.0
            rest[0] /= n
            rest[1] /= n
            rest[2] /= n
            # screen right: the sensor axis that survives being projected out
            # of vertical — whichever one the rest pose leans on least
            m0, m1, m2 = abs(rest[0]), abs(rest[1]), abs(rest[2])
            ax = 0 if m0 <= m1 and m0 <= m2 else (1 if m1 <= m2 else 2)
            r = [-rest[ax] * rest[i] for i in range(3)]
            r[ax] += 1.0
            n = math.sqrt(r[0] ** 2 + r[1] ** 2 + r[2] ** 2) or 1.0
            r = [v / n for v in r]
            # the other screen axis points at you, matching the water sim's
            # near/far convention (positive tilt pools the coffee at the near
            # rim, which is the one it spills over)
            f = [r[1] * rest[2] - r[2] * rest[1],
                 r[2] * rest[0] - r[0] * rest[2],
                 r[0] * rest[1] - r[1] * rest[0]]
            self._imu_basis = (r, f, list(rest))
            if self._calibration:
                try:
                    self._imu_basis = basis_for_rest(self._calibration, rest)
                except ValueError:
                    pass  # an extreme pose cannot define a horizontal screen axis
        return self._imu_basis

    def imu_input(self, a, g, dt):
        """Real laptop motion from the SPU IMU (a in g, gyro in deg/s).

        Tilt is the rotation away from the calibrated rest pose, resolved
        onto screen axes: drop the right side of the machine and the coffee
        runs right, tip the screen toward you and it runs toward you.
        """
        dt = max(1e-3, min(0.25, dt))
        basis = self._imu_orient(a, g, dt)
        if basis is None:
            return
        r, f, u = basis            # screen right, screen near, vertical
        up = self._imu_up
        mx, my, swap = self._imu_flip   # chassis convention (CAF_IMU_FLIP)
        # how far vertical has swung off the rest pose, along each screen axis
        ur = up[0] * r[0] + up[1] * r[1] + up[2] * r[2]
        uf = up[0] * f[0] + up[1] * f[1] + up[2] * f[2]
        if swap:
            ur, uf = uf, ur
        self.gravity = (-ur * mx, -sum(up[i] * u[i] for i in range(3)), -uf * my)
        # vertical leaning right means the *left* side is down, hence the sign
        tx = tilt_curve(-math.asin(max(-1.0, min(1.0, ur))) * mx)
        ty = tilt_curve(-math.asin(max(-1.0, min(1.0, uf))) * my)
        k = min(1.0, dt / IMU_SMOOTH)
        self.tilt_in = (self.tilt_in[0] + (tx - self.tilt_in[0]) * k,
                        self.tilt_in[1] + (ty - self.tilt_in[1]) * k)
        self.roll += (self.tilt_in[0] * .09 - self.roll) * k
        self.wind += self.tilt_in[0] * 9 * dt        # steam leans with tilt
        # linear shoves: slosh + 2.5D depth push + updraft. The gravity
        # estimate is a unit vector = 1 g, so subtracting it leaves the part
        # of the reading that is actually you moving the machine.
        lin = [a[i] - up[i] for i in range(3)]
        lr = (lin[0] * r[0] + lin[1] * r[1] + lin[2] * r[2])
        lf = (lin[0] * f[0] + lin[1] * f[1] + lin[2] * f[2])
        ld = lin[0] * u[0] + lin[1] * u[1] + lin[2] * u[2]
        if swap:
            lr, lf = lf, lr
        lr *= mx
        lf *= my
        self.fluid_accel = tuple(max(-40., min(40., v * 20.)) for v in (lr, ld, lf))
        mag = math.hypot(lr, lf)
        impulse_scale = min(2., dt / .066)
        if mag > 0.10:
            self.water.disturb(max(-0.8, min(0.8, -lr * 4)),
                               max(-0.8, min(0.8, -lf * 4)),
                               min(0.5, mag * 1.8) * impulse_scale, 0.15)
        if mag > 0.30:                               # hard jolts
            if self.mode3d:
                # no rigid body in 3d, so the whole jolt lands in the coffee
                self.water.disturb(max(-0.8, min(0.8, -lr * 5)),
                                   max(-0.8, min(0.8, -lf * 5)),
                                   min(0.6, mag) * impulse_scale, 0.22)
            else:
                self.cup_av += max(-1.6, min(1.6, lr * 4.5)) * impulse_scale
        # pull the machine toward you and the steam is left behind
        self.z_push = max(-1.5, min(1.5, self.z_push - lf * 2.2 * impulse_scale))
        self.updraft = max(-8.0, min(8.0, self.updraft - ld * 10 * impulse_scale))
        if self.mode3d:                              # gyro steers the camera
            sg = self._gyro_sign
            wu = (g[0] * u[0] + g[1] * u[1] + g[2] * u[2]) * sg    # spin
            wr = (g[0] * r[0] + g[1] * r[1] + g[2] * r[2]) * sg    # pitch
            self.yaw_kick = max(-0.6, min(0.6, self.yaw_kick + wu * dt * 0.033))
            self.pitch_kick = max(-0.25, min(0.25,
                                             self.pitch_kick + wr * dt * 0.0135))

    def window_motion(self, vx, vy):
        """React to the terminal window being dragged (vx/vy in px/s).

        Horizontal drags blow the steam sideways; vertical drags read as
        toward/away motion: an updraft plus a 2.5D depth push that swells or
        shrinks the wisps. Hard shoves slosh the coffee by inertia and, in 3D,
        nudge the camera for parallax.
        """
        if self.real_fluid:
            self.fluid_accel = (max(-30., min(30., vx * .01)), 0., max(-30., min(30., vy * .01)))
        self.wind = max(-8.0, min(8.0, self.wind - vx * 0.006))
        self.updraft = max(-8.0, min(8.0, self.updraft + vy * 0.005))
        self.z_push = max(-1.5, min(1.5, self.z_push + vy * 0.0012))
        speed = math.hypot(vx, vy)
        if speed > 700:                              # inertial slosh
            su = -0.65 if vx > 0 else 0.65
            if abs(vy) > abs(vx):
                su = random.uniform(-0.3, 0.3)
            self.water.disturb(su, random.uniform(-0.4, 0.4),
                               min(0.5, speed / 4000), 0.16)
            if not self.mode3d:                      # a real shove rocks the cup
                self.cup_av += max(-1.8, min(1.8, vx * 0.0005))
        if self.mode3d:
            self.yaw_kick = max(-0.3, min(0.3, self.yaw_kick - vx * 0.00012))
            self.pitch_kick = max(-0.2, min(0.2, self.pitch_kick + vy * 0.00010))

    def write_word(self, text):
        """Steam particles converge to spell `text` above the cup, then dissolve."""
        text = "".join(ch for ch in text.upper() if ch in FONT) or "?"
        avail = max(8, self.cup_top * 2 - 6)
        k = max(1, min(4, (self.cup_w * 2 - 4) // (len(text) * 4),
                       avail // 8))
        w_dots = len(text) * 4 * k - k
        x0 = self.cx * 2 - w_dots // 2
        y0 = max(2, int(self.cup_top * 2 * 0.42) - (5 * k) // 2)
        targets = []
        for ci, ch in enumerate(text):
            for ry, rowbits in enumerate(FONT[ch]):
                for rx, bit in enumerate(rowbits):
                    if bit == "1":
                        for sy in range(k):
                            for sx in range(k):
                                targets.append((x0 + (ci * 4 + rx) * k + sx,
                                                y0 + ry * k + sy))
        if len(targets) > 420:
            targets = random.sample(targets, 420)
        # in 3d mode words are drawn by a separate screen-space swarm (the
        # real steam lives in world coordinates)
        plist = self.flat if self.mode3d else self.particles
        pool = sorted(plist, key=lambda p: p[3])                # youngest first
        pairs = []
        for i, (bx, by) in enumerate(targets):
            if i < len(pool):
                p = pool[i]
            else:
                p = [self.cx + random.gauss(0, self.cup_w * 0.2),
                     float(self.cup_top + self.rim_h // 2),
                     random.uniform(0, math.tau), 0.0, self.cup_top * 1.0, 0.0]
                plist.append(p)
            pairs.append((p, bx / 2, by / 2))
        self.word = dict(pairs=pairs, until=self.t + 3.2)

    # ---- layout ----------------------------------------------------------

    def layout(self, cols, rows):
        self.cols, self.rows = cols, rows
        self.W = cols
        self.H = (rows - 1) * 2
        cup_h = max(8, min(40 * max(1, self.S), int(self.H * 0.42)))
        cup_w = int(cup_h * 1.7)
        max_w = self.W - max(10, self.W // 6)
        if cup_w > max_w:
            cup_w = max_w
            cup_h = max(8, int(cup_w / 1.7))
        self.cup_w, self.cup_h = cup_w, cup_h
        self.saucer_h = max(3, cup_h // 8)
        self.cx = self.W // 2 - max(2, cup_w // 10)
        self.cup_bot = self.H - 2 - self.saucer_h
        self.cup_top = self.cup_bot - cup_h
        self.rim_h = max(3, cup_h // 5)
        self.steam_by = max(2, (self.cup_top + self.rim_h) * 2)
        if len(self.puddle) != self.W:
            self.puddle = [0.0] * self.W
            self.drops = []
        self.cup_dx = max(-self.cx + 4, min(self.W - self.cx - 4, self.cup_dx))
        if self.mode3d:
            self._anchor3d()

    def _anchor3d(self):
        """Derive the 2D steam/word anchors from the projected 3D rim."""
        ci, cj = project3d(self, 0.0, 1.0, 0.0)
        _, _, _, _, _, _, rx, ry, rz, _, _, _ = cam3d(*cam_angles(self))
        ri, _ = project3d(self, 0.8 * rx, 1.0 + 0.8 * ry, 0.8 * rz)
        half_w = max(4.0, abs(ri - ci))
        self.cx = int(ci)
        self.cup_w = int(half_w * 2)
        self.cup_top = max(2, int(cj))
        self.rim_h = max(2, int(half_w * math.sin(self.pitch)))
        self.steam_by = max(2, (self.cup_top + self.rim_h) * 2)

    # ---- cup rigid body: rocking, spilling, sliding, falling -------------

    def _spawn_drops(self, n, side, splash=False, frontal=0):
        """Spill droplets. side = lateral rim (-1/+1); frontal = +1 pours
        over the near rim (falls in front of the cup), -1 over the far rim
        (falls behind it, occluded)."""
        hw0 = self.cup_w / 2
        sc = max(1, self.S)
        for _ in range(n):
            if frontal:
                rx = self.cx + self.cup_dx + random.uniform(-0.75, 0.75) * hw0
                ry = (self.cup_top + self.cup_dy
                      + (self.rim_h if frontal > 0 else 0) + self.cup_ang * hw0 * 0.4)
                vx = (self.cup_vx + random.uniform(-3, 3)) * sc
                layer = 0 if frontal > 0 else 1
            else:
                rx = self.cx + self.cup_dx + side * hw0 * random.uniform(0.7, 0.95)
                ry = (self.cup_top + self.cup_dy + self.rim_h * 0.5
                      + abs(self.cup_ang) * hw0 * 0.5)
                vx = (side * random.uniform(4, 14) + self.cup_vx
                      + (random.uniform(-22, 22) if splash else 0)) * sc
                layer = 0
            self.drops.append([rx + random.uniform(-1.5, 1.5) * sc,
                               ry + random.uniform(-1.0, 1.0) * sc, vx,
                               (random.uniform(-14, 2) if splash
                                else random.uniform(-3, 3)) * sc, layer])

    def _dump_liquid(self):
        """Everything still in the cup hits the floor."""
        if self.level > 0.04:
            side = math.copysign(1.0, self.cup_ang or 1.0)
            self._spawn_drops(int(6 + self.level * 16), side, splash=True)
        self.level = self.target_level = 0.02

    def _cup_physics(self, dt):
        t = self.t
        st = self.cup_state
        ch = max(6, self.cup_h)
        hw0 = self.cup_w / 2
        floor_y = self.H - 2
        G = ch * 3.2
        drive = self.tilt_in[0]

        if self.reset_at is not None and t >= self.reset_at:
            self.cup_state = "seated"
            self.cup_ang = self.cup_av = 0.0
            self.cup_dx = self.cup_dy = self.cup_vx = self.cup_vy = 0.0
            self.reset_at = None
            self.stains.clear()
            self.target_level = 1.0
            if self.snd:
                self.snd("glug", 0.5)
            return

        if st in ("seated", "floor"):
            crit = 0.35
            torque = drive * 3.2
            if abs(self.cup_ang) < crit:
                torque -= self.cup_ang * 9.0
            else:
                torque += math.copysign((abs(self.cup_ang) - crit) * 13.0,
                                        self.cup_ang)
            self.cup_av = (self.cup_av + torque * dt) * math.exp(-dt * 2.2)
            self.cup_ang += self.cup_av * dt
            # sustained hard tilt overcomes friction: the cup starts to slide
            if abs(drive) > 0.55:
                self.cup_vx += (drive - math.copysign(0.55, drive)) * ch * 2.4 * dt
            self.cup_vx *= math.exp(-dt * 3.0)
            self.cup_dx += self.cup_vx * dt
            if st == "seated":
                s_hw = self.cup_w * 0.75
                if abs(self.cup_dx) > s_hw - hw0 * 0.35:      # off the saucer edge
                    self.cup_state = "airborne"
                    self.spills += 1
                    self.cup_vy = 0.0
                    self.cup_av += math.copysign(random.uniform(0.8, 1.6),
                                                 self.cup_dx)
                    if self.snd:
                        self.snd("clink", 0.6)
            else:
                lim = self.W - hw0 - 2 - self.cx
                self.cup_dx = max(hw0 + 2 - self.cx, min(lim, self.cup_dx))
            if abs(self.cup_ang) > 1.0:                       # past the point of no return
                self.cup_state = "airborne"
                if st == "seated":
                    self.spills += 1
                self.cup_av += math.copysign(1.4, self.cup_ang)
            # liquid over the rim: level + slosh + lean decide the overflow,
            # on any of the four rims (left/right and near/far)
            eff = drive + self.cup_ang * 2.0
            ty = self.tilt_in[1]
            head_x = self.level * 0.45 + abs(eff) * 0.38 + abs(self.cup_ang) * 0.30
            head_y = self.level * 0.45 + abs(ty) * 0.56
            head = max(head_x, head_y)
            if head > 0.75 and self.level > 0.06:
                exc = min(0.5, head - 0.75)
                self.level = max(0.02, self.level - exc * 2.6 * dt)
                self.target_level = min(self.target_level, self.level)
                if random.random() < exc * 22 * dt + 0.1:
                    if head_x >= head_y:
                        self._spawn_drops(random.randint(1, 3),
                                          math.copysign(1.0, eff))
                    else:
                        self._spawn_drops(random.randint(1, 3), 0,
                                          frontal=1 if ty > 0 else -1)
                if self.snd and random.random() < dt * 1.5:
                    self.snd("drip", 0.4)
                if self.reset_at is None and self.level < 0.5:
                    self.spills += 1
                    self.reset_at = t + 11.0      # housekeeping brings a refill

        elif st == "airborne":
            self.cup_vy += G * dt
            self.cup_vx *= math.exp(-dt * 0.3)
            self.cup_dx += self.cup_vx * dt
            self.cup_dy += self.cup_vy * dt
            self.cup_ang += self.cup_av * dt
            self.cup_av *= math.exp(-dt * 0.4)
            wx = self.cx + self.cup_dx                        # terminal walls
            if wx < hw0 + 2:
                self.cup_dx += hw0 + 2 - wx
                self.cup_vx = abs(self.cup_vx) * 0.5
                self.cup_av = -self.cup_av * 0.6
                if self.snd:
                    self.snd("clink", 0.5)
            elif wx > self.W - hw0 - 2:
                self.cup_dx -= wx - (self.W - hw0 - 2)
                self.cup_vx = -abs(self.cup_vx) * 0.5
                self.cup_av = -self.cup_av * 0.6
                if self.snd:
                    self.snd("clink", 0.5)
            if abs(self.cup_ang) > 0.6:                       # coffee pours out mid-air
                self._dump_liquid()
            if self.cup_bot + self.cup_dy >= floor_y:         # floor contact
                self.cup_dy = floor_y - self.cup_bot
                if self.cup_vy > G * 0.30:                    # hard hit: bounce
                    self.cup_vy = -self.cup_vy * 0.36
                    self.cup_vx *= 0.75
                    self.cup_av = self.cup_av * 0.5 + random.uniform(-0.8, 0.8)
                    if self.snd:
                        self.snd("crash", 0.8)
                elif abs(self.cup_ang) < 0.30 and abs(self.cup_av) < 1.2:
                    self.cup_state = "floor"                  # stuck the landing!
                    self.cup_vy = 0.0
                    self.cup_ang *= 0.5
                    if self.reset_at is None:
                        self.reset_at = t + 12.0
                    if self.snd:
                        self.snd("clink", 0.7)
                else:                                         # tipped over for good
                    self.cup_state = "fallen"
                    self.cup_vy = self.cup_vx = self.cup_av = 0.0
                    self.cup_ang = math.copysign(math.pi / 2 + 0.05,
                                                 self.cup_ang or 1.0)
                    self._dump_liquid()
                    self.reset_at = t + 9.0
                    self.write_word("OOPS")
                    if self.snd:
                        self.snd("crash", 1.0)

    def _drops_step(self, dt):
        sc = max(1, self.S)
        ch = max(6, self.cup_h)
        G = ch * 3.2
        floor_y = self.H - 2
        s_hw = self.cup_w * 0.75
        keep = []
        for d in self.drops:
            d[3] += G * dt
            d[0] += d[2] * dt
            d[1] += d[3] * dt
            if d[0] < 1:
                d[0], d[2] = 1.0, abs(d[2]) * 0.4
            elif d[0] > self.W - 2:
                d[0], d[2] = self.W - 2.0, -abs(d[2]) * 0.4
            on_saucer = (self.cup_bot - 1 <= d[1] <= self.cup_bot + self.saucer_h
                         and abs(d[0] - self.cx) < s_hw * 0.97 and d[3] > 0)
            if on_saucer:
                xi = int(d[0])
                self.stains[xi] = min(1.0, self.stains.get(xi, 0.0) + 0.30)
                if random.random() < 0.35:                    # splashes off the rim
                    d[2] += math.copysign(random.uniform(4, 9) * sc, d[0] - self.cx)
                    d[3] = -d[3] * 0.3
                    keep.append(d)
                continue
            if d[1] >= floor_y:
                xi = max(0, min(self.W - 1, int(d[0])))
                self.puddle[xi] += 0.55 * sc
                continue
            keep.append(d)
        self.drops = keep
        # the puddle spreads along the floor, held in by the terminal walls
        p = self.puddle
        if any(v > 0.01 for v in p):
            W = self.W
            k = min(0.45, dt * 7.0)
            ev = dt * (0.05 * sc if self.reset_at is None else 0.16 * sc)
            prev = p[0]
            for x in range(W):
                left = prev
                right = p[x + 1] if x < W - 1 else p[x]
                prev = p[x]
                p[x] += ((left + right) / 2 - p[x]) * k
                p[x] = max(0.0, p[x] - ev)
            if self.heat > 0.15 and random.random() < 0.5:    # wisps off hot spill
                wet = [x for x in range(0, W, 3) if p[x] > 0.3 * sc]
                if wet:
                    x = random.choice(wet) + random.uniform(-1, 1)
                    self.particles.append([x, float(self.H - 4),
                                           random.uniform(0, math.tau), 0.0,
                                           random.uniform(0.4, 0.7) * self.cup_top,
                                           0.0])

    # ---- simulation ------------------------------------------------------

    def _sample_heat(self):
        try:
            self.heat = min(1.0, os.getloadavg()[0] / max(1, os.cpu_count() or 1))
        except OSError:
            self.heat = 0.3

    def step(self, dt):
        t = self.t
        if self.mode3d:
            if self.auto_orbit:
                self.yaw += dt * 0.10
            self._anchor3d()
        if t - self._heat_at > 1.0:
            self._heat_at = t
            self._sample_heat()
        pouring = ((self.fluid_stats.get("pour_remaining", 0)+self.fluid_stats.get("cream_remaining", 0)) > 0 if self.real_fluid
                   else self.target_level - self.level > 0.04)
        if pouring and not getattr(self, "_was_pouring", False) and self.snd:
            self.snd("glug", 0.55)
        self._was_pouring = pouring
        if not self.real_fluid:
            self.level += (self.target_level - self.level) * min(1.0, dt * (1.2 if pouring else 2.5))
        self.fluid_accel = tuple(v * math.exp(-dt*12) for v in self.fluid_accel)
        self.wind *= math.exp(-dt * 1.2)
        decay = math.exp(-dt * 1.6)
        self.updraft *= decay
        self.z_push *= decay
        self.yaw_kick *= decay
        self.pitch_kick *= decay

        # --- cup body + spilled coffee ---
        if not self.mode3d:
            self._cup_physics(dt)
            if self.drops or any(v > 0.01 for v in self.puddle):
                self._drops_step(dt)

        # Legacy heightfield is not a second force source for APIC.
        if not self.real_fluid:
            # --- water surface ---
            w = self.water
            if self.mode3d:
                # the surface plane already sits at the real slope (liquid_plane),
                # so the height field only carries enough tilt to slosh toward the
                # low side — any more and the bump map double-counts the lean
                w.tilt = (self.tilt_in[0] * 0.35, self.tilt_in[1] * 0.35)
            else:
                w.tilt = (self.tilt_in[0] + self.cup_ang * 2.0, self.tilt_in[1])
            self._water_clock += dt
            while self._water_clock >= 1/15:
                w.step()
                self._water_clock -= 1/15
            if random.random() < (0.25 + self.heat * 0.5) * min(1., dt*15):            # thermal jitter
                w.disturb(random.uniform(-0.7, 0.7), random.uniform(-0.7, 0.7),
                          random.uniform(0.008, 0.02 + 0.08 * self.heat), 0.08)
            if self.heat > 0.45 and random.random() < (self.heat - 0.4) * 0.9 * min(1., dt*15):
                w.disturb(random.uniform(-0.5, 0.5), random.uniform(-0.5, 0.5), 0.3, 0.06)  # boil bubble
            stir_age = t - self.stir_t
            if 0 <= stir_age < 1.3:                                  # orbiting spoon
                ang = stir_age * 9.0
                w.disturb(math.cos(ang) * 0.55, math.sin(ang) * 0.55, 0.35, 0.1)
            if pouring:
                w.disturb(-0.15, -0.2, random.uniform(0.15, 0.4), 0.09)


        # --- steam particles ---
        heat_k = 0.5 + 0.9 * self.heat
        word_set = set()
        if self.word:
            if t > self.word["until"]:
                for p, _, _ in self.word["pairs"]:
                    p[3] = min(p[3], p[4] * 0.35)
                self.word = None
            else:
                ease = min(1.0, dt * 5)
                for p, tx, ty in self.word["pairs"]:
                    p[0] += (tx - p[0]) * ease
                    p[1] += (ty - p[1]) * ease
                    word_set.add(id(p))

        if self.mode3d:
            # world-space wisps rising off the liquid surface
            liq_y = 0.30 + 0.62 * self.level
            pl = liquid_plane(self, liq_y)
            lean_x, lean_z = (-pl[4], -pl[5]) if pl else (0.0, 0.0)
            rate = int((2 + self.heat * 4) * (0.4 + 0.6 * self.level))
            if self.level < 0.05:
                rate = 0
            for _ in range(rate):
                if random.random() < 0.6 * min(1., dt*15):
                    r = math.sqrt(random.random()) * 0.5
                    aa = random.uniform(0, math.tau)
                    self.particles.append([r * math.cos(aa), liq_y + 0.02,
                                           r * math.sin(aa),
                                           random.uniform(0, math.tau), 0.0,
                                           random.uniform(1.8, 3.2)])
            alive = []
            for p in self.particles:
                n1, _ = curl(p[0] * 1.6 + t * 0.25, p[1] * 1.6)
                n3 = vnoise(p[2] * 1.6, p[1] * 1.6 + t * 0.25) - 0.5
                rise = ((0.30 + 0.18 * self.heat + self.updraft * 0.05)
                        * (1 + 0.25 * math.sin(p[3] + p[1] * 2.2)))
                # rise is along real vertical, not the cup's axis
                p[0] += (n1 * 0.38 + self.wind * 0.045 + lean_x * rise) * dt
                p[1] += rise * dt
                p[2] += (n3 * 0.55 + lean_z * rise) * dt
                p[4] += dt
                if p[4] < p[5] and p[1] < 2.8:
                    alive.append(p)
            self.particles = alive
            # screen-space particles that spell steam words
            alive = []
            for p in self.flat:
                if id(p) in word_set:
                    alive.append(p)
                    continue
                nx, ny = curl(p[0] * 0.08, p[1] * 0.08)
                p[0] += (nx * 10 + math.sin(t * 0.5) * 1.2) * dt * 2.2
                p[1] -= (13 + 7 * math.sin(p[2]) - ny * 6) * dt * 1.35
                p[3] += dt * 22
                if p[3] < p[4] and p[1] > 1:
                    alive.append(p)
            self.flat = alive
        else:
            rate = max(2, int((self.cup_w // 5) * (0.25 + 0.75 * self.level) * heat_k))
            if self.cup_state == "fallen" or self.level < 0.05:
                rate = 0
            for _ in range(rate):
                if random.random() < 0.65:
                    k = random.randrange(3)
                    plume = (self.cx + self.cup_dx
                             + math.sin(t * 0.6 + k * 2.1) * self.cup_w * 0.24)
                    self.particles.append([plume + random.gauss(0, 1.2),
                                           float(self.cup_top + self.cup_dy + self.rim_h // 2),
                                           random.uniform(0, math.tau), 0.0,
                                           random.uniform(0.7, 1.05) * self.cup_top, 0.0])

            alive = []
            top = max(1, self.cup_top)
            speed = 1.0 + 0.5 * self.heat
            for p in self.particles:
                if id(p) in word_set:
                    alive.append(p)
                    continue
                s = 6 + 22 * max(0.0, 1 - p[1] / top)
                nx, ny = curl(p[0] * 0.08 / max(1, self.S), p[1] * 0.08 / max(1, self.S), )
                sc = max(1, self.S)
                p[0] += (nx * s * sc + math.sin(t * 0.5) * 1.2 * sc + self.wind * 6 * sc * 0.1) * dt * 2.2
                p[1] -= (13 + 7 * math.sin(p[2]) - ny * s * 0.6 + self.updraft * 5) * dt * 1.35 * sc * speed
                p[5] += (self.z_push - p[5]) * min(1.0, dt * 2.5)
                p[3] += dt * 22
                if p[3] < p[4] and p[1] > 1:
                    alive.append(p)
            self.particles = alive

        # --- weather ---
        sc = max(1, self.S)
        if self.weather == "rain":
            for _ in range(max(1, self.W // 40)):
                if random.random() < 0.7:
                    self.precip.append([random.uniform(0, self.W), 0.0, 0.35 * sc, 26.0 * sc])
        elif self.weather == "snow":
            if random.random() < 0.5:
                self.precip.append([random.uniform(0, self.W), 0.0,
                                    random.uniform(-1, 1) * sc, 5.0 * sc])
        keep = []
        for q in self.precip:
            q[0] += (q[2] + (math.sin(t * 0.8 + q[1] * 0.3) * 0.8 * sc if self.weather == "snow" else 0)) * dt
            q[1] += q[3] * dt
            if q[1] * 2 < self.steam_by and 0 <= q[0] < self.W:
                keep.append(q)
        self.precip = keep

        if self.theme["sparkle"] and not self.S:
            if random.random() < 0.18:
                self.sparkles.append([random.randint(2, self.cols - 3),
                                      random.randint(1, max(2, self.cup_top // 2 - 1)), 0])
            self.sparkles = [[c, r, a + 1] for c, r, a in self.sparkles if a < 7]

    # ---- drawing ---------------------------------------------------------

    def _dim_theme(self):
        amb = self.ambient
        if amb >= 0.975:
            self._th = self.theme
        else:
            th = dict(self.theme)
            for k in COLOR_KEYS:
                # steam dims less: it catches what light remains
                th[k] = shade(self.theme[k], amb ** 0.5 if k == "steam" else amb)
            self._th = th
        return self._th

    def draw(self):
        th = self._dim_theme()
        if self.mode3d:
            px = render3d(self)
            if self.S:
                sgrid = None
                self._splat3d(px, None)
                self._splat_hires(px, self.flat)
            else:
                sgrid = [[0.0] * (self.W * 2) for _ in range(self.H * 2)]
                self._splat3d(px, sgrid)
                self._splat_braille(px, sgrid, self.flat)
            return px, sgrid
        W, H = self.W, self.H
        px = [[None] * W for _ in range(H)]
        t = self.t
        cx, cup_w, cup_h = self.cx, self.cup_w, self.cup_h
        top, bot, rim_h = self.cup_top, self.cup_bot, self.rim_h
        hw0 = cup_w / 2

        # sun halo: a warm static glow behind the cup
        if self.weather == "sun":
            hcy = top + cup_h * 0.35
            rx, ry = cup_w * 0.95, cup_h * 1.15
            for y in range(max(0, int(hcy - ry)), min(H, int(hcy + ry) + 1)):
                for x in range(max(0, int(cx - rx)), min(W, int(cx + rx) + 1)):
                    d = ((x - cx) / rx) ** 2 + ((y - hcy) / ry) ** 2
                    if d < 1:
                        px[y][x] = mix(BG_COL, (120, 84, 30), (1 - d) * 0.5)

        # saucer (stays put; collects coffee stains on its top surface)
        s_w = cup_w * 1.5
        stains = self.stains
        for j in range(self.saucer_h):
            tt = j / max(1, self.saucer_h - 1)
            hw = (s_w / 2) * math.sqrt(max(0.0, 1 - (tt * 0.85) ** 2))
            y = bot + j
            if y >= H:
                break
            for x in range(int(cx - hw), int(cx + hw) + 1):
                if 0 <= x < W:
                    k = 0.9 - 0.45 * tt + 0.25 * math.exp(-((x - cx + hw * 0.3) / (hw * 0.45 + 1)) ** 2)
                    col = shade(th["saucer"], k)
                    if stains and j <= 1:
                        s = stains.get(x, 0.0)
                        if s:
                            col = mix(col, shade(th["liquid"], 0.55), min(0.75, s * 0.75))
                    px[y][x] = col

        # cup (body + handle + rim + liquid) rendered into its own buffer so
        # the whole thing can lean, slide, and tumble as one rigid body
        hr = max(3, int(cup_h * 0.30))
        thick = max(1.4, cup_h * 0.07)
        bx0 = int(cx - hw0) - 3
        bx1 = int(cx + hw0 * 0.92 + hr + thick) + 3
        by0 = top - 2
        bw, bh = bx1 - bx0 + 1, cup_h + 5
        cb = [[None] * bw for _ in range(bh)]

        for j in range(rim_h // 2, cup_h + 1):                 # body
            tt = j / cup_h
            hw = hw0 * (1 - 0.16 * tt)
            if tt > 0.78:
                hw *= math.sqrt(max(0.0, 1 - ((tt - 0.78) / 0.24) ** 2))
            if hw < 1:
                continue
            row = cb[top + j - by0]
            for x in range(int(cx - hw), int(cx + hw) + 1):
                u = max(-1.0, min(1.0, (x - cx) / (hw + 1e-6)))
                k = 0.52 + 0.30 * (1 - abs(u)) ** 0.7
                k += 0.34 * math.exp(-((u + 0.45) / 0.28) ** 2)
                k -= 0.18 * max(0.0, u - 0.55)
                k *= 1.0 - 0.22 * tt
                row[x - bx0] = shade(th["cup"], k)

        hcx, hcy = cx + hw0 * 0.92, top + cup_h * 0.45         # handle
        for y in range(int(hcy - hr - thick), int(hcy + hr + thick) + 1):
            ly = y - by0
            if not (0 <= ly < bh):
                continue
            row = cb[ly]
            for x in range(int(hcx), int(hcx + hr + thick) + 1):
                lx = x - bx0
                if not (0 <= lx < bw):
                    continue
                d = math.hypot((x - hcx) * 0.78, y - hcy)
                if abs(d - hr) <= thick and x >= hcx + 1 and row[lx] is None:
                    row[lx] = shade(th["cup"], 0.55 + 0.3 * (1 - abs(d - hr) / thick))

        # rim + liquid: the water sim provides height + slope lighting
        ls = 0.45 + 0.55 * self.level
        voff = (1 - self.level) * 0.30
        wsamp = self.water.sample
        for j in range(rim_h + 1):
            v = (j - rim_h / 2) / (rim_h / 2 + 1e-6)
            hw = hw0 * math.sqrt(max(0.0, 1 - v * v))
            if hw < 1:
                continue
            row = cb[top + j - by0]
            for x in range(int(cx - hw), int(cx + hw) + 1):
                u = (x - cx) / (hw + 1e-6)
                if abs(u) > 0.86 or j == 0:
                    row[x - bx0] = shade(th["cup"], 1.05 - 0.25 * abs(u))
                    continue
                lu = u / (0.86 * ls)
                lv = (v - voff) / max(0.35, ls)
                if lu * lu + lv * lv > 1.0:
                    row[x - bx0] = shade(th["cup"], 0.30 + 0.08 * v)
                    continue
                hgt = wsamp(lu, lv)
                slope = (wsamp(lu + 0.09, lv) - hgt) + (wsamp(lu, lv + 0.09) - hgt)
                bright = 0.16 + hgt * 1.5 + slope * 3.2
                col = mix(th["liquid"], th["crema"], max(0.0, min(0.85, bright)))
                d = math.hypot(lu * 2.2, lv * 1.4)
                if d > 1.15:
                    col = mix(col, th["crema"], 0.35)
                gl = math.exp(-((lu + 0.35) ** 2 + (lv + 0.3) ** 2) / 0.18)
                col = mix(col, (255, 255, 255), 0.10 * gl)
                row[x - bx0] = col

        # droplets pouring over the far rim fall behind the cup
        sc_ = max(1, self.S)
        if self.drops:
            bdc = shade(mix(th["liquid"], th["crema"], 0.3), 0.7)
            for d in self.drops:
                if d[4] != 1:
                    continue
                xi, yi = int(d[0]), int(d[1])
                for dy2 in range(sc_):
                    for dx2 in range(max(1, sc_ // 2)):
                        X, Y = xi + dx2, yi + dy2
                        if 0 <= X < W and 0 <= Y < H:
                            px[Y][X] = bdc

        self._composite_cup(px, cb, bx0, by0, bw, bh)

        # floor puddle: spilled coffee pooling against the terminal walls
        p = self.puddle
        if any(v > 0.05 for v in p):
            liq = th["liquid"]
            cap = 4.0 * sc_
            for x in range(W):
                dpt = min(cap, p[x])
                if dpt < 0.15:
                    continue
                dep = max(1, int(dpt))
                for y in range(H - 1, max(-1, H - 1 - dep), -1):
                    px[y][x] = shade(liq, 0.65)
                ty_ = H - 1 - dep
                if 0 <= ty_ < H:
                    px[ty_][x] = mix(shade(liq, 0.85), th["crema"], 0.2)

        # flying droplets (near-rim spills run down the front of the cup)
        if self.drops:
            dc = mix(th["liquid"], th["crema"], 0.3)
            for d in self.drops:
                if d[4] != 0:
                    continue
                xi, yi = int(d[0]), int(d[1])
                for dy2 in range(sc_):
                    for dx2 in range(max(1, sc_ // 2)):
                        X, Y = xi + dx2, yi + dy2
                        if 0 <= X < W and 0 <= Y < H:
                            px[Y][X] = dc

        # pour stream while refilling
        sc = th["steam"]
        if self.target_level - self.level > 0.04:
            stream_x = cx - cup_w * 0.07
            liq_col = th["liquid"]
            for y in range(0, top + rim_h // 2):
                wob = math.sin(t * 6 + y * 0.4) * 0.8
                for dx in (0, 1):
                    xi = int(stream_x + wob) + dx
                    if 0 <= xi < W:
                        px[y][xi] = mix(liq_col, sc, 0.25)

        # steam + precip (grid covers the whole screen during a spill so
        # wisps can rise off the puddle)
        if self.S:
            sgrid = None
            self._splat_hires(px)
        else:
            act = (self.cup_state != "seated" or self.drops
                   or any(v > 0.05 for v in p))
            sgrid = [[0.0] * (W * 2) for _ in range(H * 2 if act else self.steam_by)]
            self._splat_braille(px, sgrid)
        return px, sgrid

    def _composite_cup(self, px, cb, bx0, by0, bw, bh):
        """Blit the cup buffer, rotated about its pivot and translated."""
        W, H = self.W, self.H
        ang, ddx, ddy = self.cup_ang, self.cup_dx, self.cup_dy
        if abs(ang) < 0.02 and abs(ddx) < 0.5 and abs(ddy) < 0.5:
            for y in range(bh):
                ty = y + by0
                if not (0 <= ty < H):
                    continue
                row, prow = cb[y], px[ty]
                for x in range(bw):
                    c = row[x]
                    if c is not None:
                        tx = x + bx0
                        if 0 <= tx < W:
                            prow[tx] = c
            return
        # grounded cups rock on the bottom corner of the leaning side
        pvx = self.cx + (math.copysign(self.cup_w * 0.26, ang)
                         if self.cup_state in ("seated", "floor") else 0.0)
        pvy = float(self.cup_bot)
        ca, sa = math.cos(ang), math.sin(ang)
        xs, ys = [], []
        for X, Y in ((bx0, by0), (bx0 + bw, by0),
                     (bx0, by0 + bh), (bx0 + bw, by0 + bh)):
            rx_, ry_ = X - pvx, Y - pvy
            xs.append(pvx + ca * rx_ - sa * ry_ + ddx)
            ys.append(pvy + sa * rx_ + ca * ry_ + ddy)
        xmin, xmax = max(0, int(min(xs)) - 1), min(W - 1, int(max(xs)) + 1)
        ymin, ymax = max(0, int(min(ys)) - 1), min(H - 1, int(max(ys)) + 1)
        lox, loy = pvx - bx0, pvy - by0
        for yd in range(ymin, ymax + 1):
            prow = px[yd]
            wy = yd - ddy - pvy
            rx_off = lox + sa * wy
            ry_off = loy + ca * wy
            for xd in range(xmin, xmax + 1):
                wx = xd - ddx - pvx
                sxi = int(rx_off + ca * wx + 0.5)
                syi = int(ry_off - sa * wx + 0.5)
                if 0 <= sxi < bw and 0 <= syi < bh:
                    c = cb[syi][sxi]
                    if c is not None:
                        prow[xd] = c

    def _splat3d(self, px, sgrid):
        """Volumetric steam: world-space wisps projected through the orbit
        camera, occluded by the cup via the depth buffer, lit by the key."""
        W, H = self.W, self.H
        sc = self._th["steam"]
        zb, zw, zh = self._zb
        ex, ey, ez, fx, fy, fz, rx, ry, rz, ux, uy, uz = cam3d(*cam_angles(self))
        lx, lz = -0.4082, -0.4876
        aspect = W / H
        bw = W * 2
        sgh = len(sgrid) if sgrid is not None else 0
        S = self.S
        for p in self.particles:
            wx, wy, wz, ph, age, life = p
            cxp, cyp, czp = wx - ex, wy - ey, wz - ez
            zc = cxp * fx + cyp * fy + czp * fz
            if zc < 0.4:
                continue
            uc = (cxp * rx + cyp * ry + czp * rz) / zc * 1.9
            vc = (cxp * ux + cyp * uy + czp * uz) / zc * 1.9
            i = (uc / (aspect * 0.95) + 1) / 2 * W
            j = (1 - (vc + 0.28) / 0.95) / 2 * H
            if not (0 <= i < W and 0 <= j < H):
                continue
            ii, jj = int(i) * zw // W, int(j) * zh // H
            if zc > zb[jj][ii] + 0.04:
                continue                              # hidden behind the cup
            a = max(0.0, 1 - age / life) ** 1.3 * 0.9
            a *= min(1.0, 0.25 + age * 2.2)           # fade in off the surface
            a *= 0.6 + 0.5 * max(0.0, (wx * lx + wz * lz) + 0.6)   # key light
            near = 3.4 / zc
            if S:
                R = max(1, int(S * (0.5 + (1 - a) * 0.8) * near))
                xi0, yi0 = int(i), int(j)
                for dy in range(-R, R + 1):
                    yi = yi0 + dy
                    if not (0 <= yi < H):
                        continue
                    row = px[yi]
                    for dx in range(-R, R + 1):
                        d2 = dx * dx + dy * dy
                        if d2 > R * R:
                            continue
                        xi = xi0 + dx
                        if not (0 <= xi < W):
                            continue
                        w = a * (1 - 0.7 * math.sqrt(d2) / R) * 0.5
                        base = row[xi] if row[xi] is not None else BG_COL
                        row[xi] = mix(base, sc, min(1.0, w))
            elif px[int(j)][int(i)] is not None:
                # in front of the cup: blend straight into the render
                pxi, pyj = int(i), int(j)
                px[pyj][pxi] = mix(px[pyj][pxi], sc, min(0.6, a * 0.55))
                if pxi + 1 < W and px[pyj][pxi + 1] is not None:
                    px[pyj][pxi + 1] = mix(px[pyj][pxi + 1], sc, min(0.4, a * 0.3))
            else:
                bx, by = int(i * 2), int(j * 2)
                spread = max(1, round((1 + (1 - a) * 2) * near))
                for dx, dy, w in ((0, 0, 1.0), (-1, 0, 0.55), (1, 0, 0.55),
                                  (0, -1, 0.5), (0, 1, 0.35),
                                  (-1, -1, 0.3), (1, -1, 0.3), (-1, 1, 0.22),
                                  (1, 1, 0.22), (-2, 0, 0.15), (2, 0, 0.15)):
                    xi, yi = bx + dx * spread, by + dy
                    if 0 <= xi < bw and 0 <= yi < sgh:
                        sgrid[yi][xi] += a * w

    def _splat_braille(self, px, sgrid, plist=None):
        W, H = self.W, self.H
        sc = self._th["steam"]
        bw = W * 2
        sgh = len(sgrid)
        for p in (self.particles if plist is None else plist):
            x, y, age, life, pz = p[0], p[1], p[3], p[4], p[5]
            zk = 1.0 + pz * 0.55
            a = max(0.0, 1 - age / life) ** 1.3 * 0.95
            a = min(1.0, a * (1.0 + pz * 0.35))
            spread = max(1, int((1 + (1 - a) * 2) * zk))
            bx, by = int(x * 2), int(y * 2)
            for dx, dy, w in ((0, 0, 1.0), (-1, 0, 0.55), (1, 0, 0.55),
                              (0, -1, 0.5), (0, 1, 0.35),
                              (-1, -1, 0.3), (1, -1, 0.3), (-1, 1, 0.22), (1, 1, 0.22),
                              (-2, 0, 0.15), (2, 0, 0.15)):
                xi, yi = bx + dx * spread, by + dy
                if 0 <= xi < bw and 0 <= yi < sgh:
                    sgrid[yi][xi] += a * w
            pyi, pxi = int(y), int(x)
            if 0 <= pxi < W and 0 <= pyi < H and px[pyi][pxi] is not None:
                px[pyi][pxi] = mix(px[pyi][pxi], sc, min(1.0, a * 0.55))
        for qx, qy, _, vy in self.precip:
            bx, by = int(qx * 2), int(qy * 2)
            if 0 <= bx < bw and 0 <= by < sgh:
                sgrid[by][bx] += 0.5
                if self.weather == "rain" and by + 1 < sgh:
                    sgrid[by + 1][bx] += 0.3

    def _splat_hires(self, px, plist=None):
        W, H = self.W, self.H
        S = self.S
        sc = self._th["steam"]
        for p in (self.particles if plist is None else plist):
            x, y, age, life, pz = p[0], p[1], p[3], p[4], p[5]
            a = max(0.0, 1 - age / life) ** 1.3 * 0.95
            a = min(1.0, a * (1.0 + pz * 0.35))
            R = max(1, int((S * 0.5 + (1 - a) * S * 0.9) * (1.0 + pz * 0.55)))
            xi0, yi0 = int(x), int(y)
            for dy in range(-R, R + 1):
                yi = yi0 + dy
                if not (0 <= yi < H):
                    continue
                row = px[yi]
                for dx in range(-R, R + 1):
                    d2 = dx * dx + dy * dy
                    if d2 > R * R:
                        continue
                    xi = xi0 + dx
                    if not (0 <= xi < W):
                        continue
                    w = a * (1 - 0.7 * math.sqrt(d2) / R) * 0.55
                    base = row[xi] if row[xi] is not None else BG_COL
                    row[xi] = mix(base, sc, min(1.0, w))
        pc = (150, 170, 220) if self.weather == "rain" else (235, 235, 240)
        for qx, qy, _, _ in self.precip:
            xi, yi = int(qx), int(qy)
            if 0 <= xi < W and 0 <= yi < H and px[yi][xi] is None:
                px[yi][xi] = pc

    # ---- blit: buffers -> terminal lines (ANSI mode) ---------------------

    def blit(self, px, sgrid):
        out = []
        sc = self._th["steam"]
        sgh = len(sgrid)
        steam_cell_rows = sgh // 4 + 1
        for row in range(self.rows - 1):
            top, bot = px[2 * row], px[2 * row + 1]
            line = []
            last_fg = object(); last_bg = object()
            for x in range(self.W):
                a, b = top[x], bot[x]
                if a is None and b is None:
                    if row < steam_cell_rows:
                        bits = 0
                        total = 0.0
                        lit = 0
                        for dx in (0, 1):
                            gx = x * 2 + dx
                            for dy in range(4):
                                gy = row * 4 + dy
                                if gy < sgh:
                                    val = sgrid[gy][gx]
                                    if val > 0.12:
                                        bits |= BRAILLE_BIT[dx][dy]
                                        total += val
                                        lit += 1
                        if bits:
                            col = mix((0, 0, 0), sc, min(1.0, (total / lit) * 1.25))
                            if col != last_fg:
                                line.append(fg(col)); last_fg = col
                            if last_bg is not None:
                                line.append("\x1b[49m"); last_bg = None
                            line.append(chr(0x2800 | bits))
                            continue
                    if last_fg is not None or last_bg is not None:
                        line.append("\x1b[0m")
                        last_fg = last_bg = None
                    line.append(" ")
                elif a is not None and b is not None:
                    if a != last_fg:
                        line.append(fg(a)); last_fg = a
                    if b != last_bg:
                        line.append(bg(b)); last_bg = b
                    line.append("▀")
                elif a is not None:
                    if last_bg is not None:
                        line.append("\x1b[49m"); last_bg = None
                    if a != last_fg:
                        line.append(fg(a)); last_fg = a
                    line.append("▀")
                else:
                    if last_bg is not None:
                        line.append("\x1b[49m"); last_bg = None
                    if b != last_fg:
                        line.append(fg(b)); last_fg = b
                    line.append("▄")
            line.append("\x1b[0m\x1b[K")
            out.append("".join(line))

        overlay = []
        for c, r, age in self.sparkles:
            if 0 <= r < len(out):
                ch = "✦" if age < 4 else "·"
                overlay.append(f"\x1b[{r + 1};{c + 1}H{fg(self.theme['sparkle'])}{ch}\x1b[0m")
        return out, "".join(overlay)

    def status(self, elapsed, interactive, extra="", zen=False, width=None):
        if zen:
            return ""
        width = width or self.cols
        th = self.theme
        m, s = divmod(int(elapsed), 60)
        h, m = divmod(m, 60)
        clock = f"{h}:{m:02d}:{s:02d}" if h else f"{m:02d}:{s:02d}"
        n = round(self.level * 4)
        cup_bar = "▇" * n + "░" * (4 - n)
        hn = min(3, int(self.heat * 3 + 0.5))
        heat_bar = "▂▄▆"[:hn] or "·"
        if self.cup_state != "seated":
            extra_cup = {"airborne": " · 🫗 !!", "floor": " · 🫗 close one",
                         "fallen": " · 🫗 spilled"}[self.cup_state]
        else:
            extra_cup = f" · 🫗 {self.spills}" if self.spills else ""
        if self.real_fluid:
            st = self.fluid_stats
            spilled = sum(st.get(k, 0) for k in ("on_saucer", "on_table", "airborne", "off_scene"))
            extra_cup = f" · {round(self.level*100)}%"
            if spilled:
                extra_cup += f" · spilled {round(100*spilled/max(1, st.get('initial', 0)+st.get('emitted', 0)))}%"
            if st.get("cream_remaining", 0):
                extra_cup += " · cream"
            if st.get("cup_tilt", 0) > 55:
                extra_cup += " · tipped [r]"
            if st.get("capacity_limited"):
                extra_cup += " · [r] reset to refill"
        extra = extra_cup + extra
        if not interactive:
            keys = " · Ctrl+C to stop"
        elif self.mode3d:
            keys = (" · [s]ip [f]ill [r]eset [m]ilk [k]nock [l]ight [␣]stir [x]nudge "
                    "[←→↑↓/o]rbit [w]rite [t]heme [q]uit")
        else:
            keys = " · [s]ip [␣]stir [x]nudge [w]rite [t]heme [q]uit"
        text = f" {th['icon']}  {th['name']} · awake {clock} · cup {cup_bar} · heat {heat_bar}{extra}{keys} "
        if len(text) > width:
            text = f" {th['icon']} {clock} {cup_bar}{extra} "
        pad = max(0, (width - len(text)) // 2)
        return " " * pad + f"\x1b[2m{text}\x1b[0m"


